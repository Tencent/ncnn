#version 450

#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(binding = 0) readonly buffer bottom_top_blob { sfpvec4 bottom_top_blob_data[]; };
layout(binding = 1) writeonly buffer rms_blob { vec4 rms_data[]; };

layout(push_constant) uniform parameter
{
    int group_size;
    int num_groups_per_channel;
    int cstep;
} p;

// spirv-1.6 guarantees one full subgroup with local size (required subgroup size, 1, 1)
#if !ncnn_maintenance4 || !ncnn_subgroupSizeControl
shared vec4 sqsum_shared[ncnn_subgroupSize];
#endif

void main()
{
    const int tid = int(gl_LocalInvocationID.x);
    const int gz = int(gl_WorkGroupID.z);
    const int gy = int(gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x);

    if (gy >= p.num_groups_per_channel)
        return;

    const int group_id = gz * p.num_groups_per_channel + gy;
    const int offset = gz * p.cstep + gy * p.group_size;

    vec4 sqsum = vec4(0.f);
    for (int t = tid; t < p.group_size; t += ncnn_subgroupSize)
    {
        const vec4 v = vec4(buffer_ld4(bottom_top_blob_data, offset + t));
        sqsum += v * v;
    }

    sqsum = subgroupAdd(sqsum);

#if !ncnn_maintenance4 || !ncnn_subgroupSizeControl
    if (gl_NumSubgroups > 1)
    {
        // combine partial sums when the workgroup has multiple subgroups
        sqsum_shared[tid] = subgroupElect() ? sqsum : vec4(0.f);
        barrier();

        if (tid == 0)
        {
            sqsum = vec4(0.f);
            for (int i = 0; i < ncnn_subgroupSize; i++)
            {
                sqsum += sqsum_shared[i];
            }
            rms_data[group_id] = sqsum / float(p.group_size);
        }
        return;
    }
#endif

    if (subgroupElect())
    {
        rms_data[group_id] = sqsum / float(p.group_size);
    }
}
