#version 450

#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(binding = 0) readonly buffer bottom_top_blob { sfp bottom_top_blob_data[]; };
layout(binding = 1) writeonly buffer mean_blob { float mean_data[]; };
layout(binding = 2) writeonly buffer var_blob { float var_data[]; };

layout(push_constant) uniform parameter
{
    int cstep;
    int size;
} p;

void main()
{
    const int tid = int(gl_LocalInvocationID.x);
    const int channel_id = int(gl_WorkGroupID.z);
    const int base_offset = channel_id * p.cstep;
    const float area = float(p.size);

    float sum = 0.f;
    for (int t = tid; t < p.size; t += ncnn_subgroupSize)
    {
        sum += float(buffer_ld1(bottom_top_blob_data, base_offset + t));
    }

    const float mean = subgroupAdd(sum) / area;
    if (subgroupElect())
    {
        mean_data[channel_id] = mean;
    }

    float sqsum = 0.f;
    for (int t = tid; t < p.size; t += ncnn_subgroupSize)
    {
        const float d = float(buffer_ld1(bottom_top_blob_data, base_offset + t)) - mean;
        sqsum += d * d;
    }

    const float variance = subgroupAdd(sqsum) / area;
    if (subgroupElect())
    {
        var_data[channel_id] = variance;
    }
}
