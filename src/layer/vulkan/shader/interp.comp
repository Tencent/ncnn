#version 450

layout(constant_id = 0) const int resize_type = 0;
layout(constant_id = 1) const int align_corner = 0;

#define shape_constant_id_offset 2
layout(constant_id = shape_constant_id_offset + 0) const int dims = 0;
layout(constant_id = shape_constant_id_offset + 1) const int w = 0;
layout(constant_id = shape_constant_id_offset + 2) const int h = 0;
layout(constant_id = shape_constant_id_offset + 3) const int c = 0;
layout(constant_id = shape_constant_id_offset + 4) const int cstep = 0;

layout(constant_id = shape_constant_id_offset + 5) const int outdims = 0;
layout(constant_id = shape_constant_id_offset + 6) const int outw = 0;
layout(constant_id = shape_constant_id_offset + 7) const int outh = 0;
layout(constant_id = shape_constant_id_offset + 8) const int outc = 0;
layout(constant_id = shape_constant_id_offset + 9) const int outcstep = 0;

layout(binding = 0) readonly buffer bottom_blob { sfp bottom_blob_data[]; };
layout(binding = 1) writeonly buffer top_blob { sfp top_blob_data[]; };

layout(push_constant) uniform parameter
{
    int dims;
    int w;
    int h;
    int c;
    int cstep;

    int outdims;
    int outw;
    int outh;
    int outc;
    int outcstep;

    float scale_x;
    float scale_y;
} p;

void main()
{
    int gx = int(gl_GlobalInvocationID.x);
    int gy = int(gl_GlobalInvocationID.y);
    int gz = int(gl_GlobalInvocationID.z);

    if (gx >= psc(outw) || gy >= psc(outh) || gz >= psc(outc))
        return;

    if (psc(dims) == 1)
    {
        const int gi = gz * psc(outcstep) + gy * psc(outw) + gx;

        buffer_cp1(top_blob_data, gi, bottom_blob_data, gz);
        return;
    }

    if (resize_type == 2 && (psc(w) == 1 || (psc(dims) == 3 && psc(h) == 1)))
    {
        const float x = align_corner == 1 ? float(gx) * p.scale_x : (float(gx) + 0.5f) * p.scale_x - 0.5f;
        const float y = psc(dims) == 2 ? float(gy) : (align_corner == 1 ? float(gy) * p.scale_y : (float(gy) + 0.5f) * p.scale_y - 0.5f);
        int sx = int(floor(x));
        int sy = int(floor(y));
        afp fx = afp(x - float(sx));
        afp fy = afp(y - float(sy));
        int x0 = clamp(sx, 0, psc(w) - 1);
        int x1 = clamp(sx + 1, 0, psc(w) - 1);
        int y0 = clamp(sy, 0, psc(h) - 1);
        int y1 = clamp(sy + 1, 0, psc(h) - 1);
        int offset = gz * psc(cstep);
        afp a = buffer_ld1(bottom_blob_data, offset + y0 * psc(w) + x0) * (afp(1.f) - fx) + buffer_ld1(bottom_blob_data, offset + y0 * psc(w) + x1) * fx;
        afp b = buffer_ld1(bottom_blob_data, offset + y1 * psc(w) + x0) * (afp(1.f) - fx) + buffer_ld1(bottom_blob_data, offset + y1 * psc(w) + x1) * fx;
        afp v = a * (afp(1.f) - fy) + b * fy;
        int gi = gz * psc(outcstep) + gy * psc(outw) + gx;
        buffer_st1(top_blob_data, gi, v);
        return;
    }

    if (psc(dims) == 2)
    {
        if (resize_type == 1) // nearest
        {
            int sx = min(int(floor(float(gx) * p.scale_x)), psc(w) - 1);

            int v_offset = gz * psc(cstep) + gy * psc(w) + sx;

            const int gi = gz * psc(outcstep) + gy * psc(outw) + gx;

            buffer_cp1(top_blob_data, gi, bottom_blob_data, v_offset);
        }
        if (resize_type == 2) // bilinear
        {
            float x;
            if (align_corner == 1)
            {
                x = float(gx) * p.scale_x;
            }
            else
            {
                x = (float(gx) + 0.5f) * p.scale_x - 0.5f;
            }

            int sx = int(floor(x));

            afp fx = afp(x - float(sx));

            int sx_max = psc(w) - 2;

            if (sx < 0)
            {
                sx = 0;
                fx = afp(0.f);
            }
            else if (sx > sx_max)
            {
                sx = sx_max;
                fx = afp(1.f);
            }

            int v_offset_0 = gz * psc(cstep) + gy * psc(w) + sx;

            afp a0 = buffer_ld1(bottom_blob_data, v_offset_0);
            afp a1 = buffer_ld1(bottom_blob_data, v_offset_0 + 1);

            afp res = a0 * (afp(1.f) - fx) + a1 * fx;

            const int gi = gz * psc(outcstep) + gy * psc(outw) + gx;

            buffer_st1(top_blob_data, gi, res);
        }

        return;
    }

    if (resize_type == 1) // nearest
    {
        vec2 gxy = vec2(gx, gy);
        ivec2 sxy_max = ivec2(psc(w) - 1, psc(h) - 1);
        ivec2 sxy = min(ivec2(floor(gxy * vec2(p.scale_x, p.scale_y))), sxy_max);

        int sx = sxy.r;
        int sy = sxy.g;

        int v_offset = gz * psc(cstep) + sy * psc(w) + sx;

        const int gi = gz * psc(outcstep) + gy * psc(outw) + gx;

        buffer_cp1(top_blob_data, gi, bottom_blob_data, v_offset);
    }
    if (resize_type == 2) // bilinear
    {
        vec2 gxy = vec2(gx, gy);
        vec2 xy;
        if (align_corner == 1)
        {
            xy = gxy * vec2(p.scale_x, p.scale_y);
        }
        else
        {
            xy = (gxy + 0.5f) * vec2(p.scale_x, p.scale_y) - 0.5f;
        }

        ivec2 sxy = ivec2(floor(xy));

        afpvec2 fxy = afpvec2(xy - vec2(sxy));

        ivec2 sxy_max = ivec2(psc(w) - 2, psc(h) - 2);

        bvec2 underflow = lessThan(sxy, ivec2(0));
        bvec2 overflow = greaterThan(sxy, sxy_max);

        sxy = clamp(sxy, ivec2(0), sxy_max);

        fxy = mix(fxy, afpvec2(0.f), underflow);
        fxy = mix(fxy, afpvec2(1.f), overflow);

        int sx = sxy.r;
        int sy = sxy.g;

        int v_offset_0 = gz * psc(cstep) + sy * psc(w) + sx;
        int v_offset_1 = gz * psc(cstep) + (sy + 1) * psc(w) + sx;

        afp a0 = buffer_ld1(bottom_blob_data, v_offset_0);
        afp a1 = buffer_ld1(bottom_blob_data, v_offset_0 + 1);
        afp b0 = buffer_ld1(bottom_blob_data, v_offset_1);
        afp b1 = buffer_ld1(bottom_blob_data, v_offset_1 + 1);

        afp fx = fxy.r;
        afp fy = fxy.g;

        afpvec2 ab = afpvec2(a0, b0) * (afp(1.f) - fx) + afpvec2(a1, b1) * fx;

        afp res = ab.r * (afp(1.f) - fy) + ab.g * fy;

        const int gi = gz * psc(outcstep) + gy * psc(outw) + gx;

        buffer_st1(top_blob_data, gi, res);
    }
}
