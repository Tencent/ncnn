#version 450

layout(constant_id = 0) const int align_corner = 0;

#define shape_constant_id_offset 1
layout(constant_id = shape_constant_id_offset + 0) const int w = 0;
layout(constant_id = shape_constant_id_offset + 1) const int outw = 0;

layout(binding = 0) writeonly buffer alpha_blob { sfpvec4 alpha_blob_data[]; };
layout(binding = 1) writeonly buffer xofs_blob { int xofs_blob_data[]; };

layout(push_constant) uniform parameter
{
    int w;
    int outw;
    float scale;
} p;

void main()
{
    int gx = int(gl_GlobalInvocationID.x);
    int gy = int(gl_GlobalInvocationID.y);
    int gz = int(gl_GlobalInvocationID.z);

    if (gx >= psc(outw) || gy >= 1 || gz >= 1)
        return;

    float x;
    if (align_corner == 1)
    {
        x = float(gx) * p.scale;
    }
    else
    {
        x = (float(gx) + 0.5f) * p.scale - 0.5f;
    }

    int sx = int(floor(x));
    float fx = x - float(sx);

    // interpolate_cubic(fx, coeffs);
    vec4 coeffs;
    {
        const float A = -0.75f;

        float fx0 = fx + 1.f;
        float fx1 = fx;
        float fx2 = 1.f - fx;
        // float fx3 = 2.f - fx;

        coeffs.r = A * fx0 * fx0 * fx0 - 5.f * A * fx0 * fx0 + 8.f * A * fx0 - 4.f * A;
        coeffs.g = (A + 2.f) * fx1 * fx1 * fx1 - (A + 3.f) * fx1 * fx1 + 1.f;
        coeffs.b = (A + 2.f) * fx2 * fx2 * fx2 - (A + 3.f) * fx2 * fx2 + 1.f;
        coeffs.a = 1.f - coeffs.r - coeffs.g - coeffs.b;
    }

    if (psc(w) >= 4)
    {
        if (sx <= -1)
        {
            sx = 1;
            coeffs.r = 1.f - coeffs.a;
            coeffs.g = coeffs.a;
            coeffs.b = 0.f;
            coeffs.a = 0.f;
        }
        if (sx == 0)
        {
            sx = 1;
            coeffs.r = coeffs.r + coeffs.g;
            coeffs.g = coeffs.b;
            coeffs.b = coeffs.a;
            coeffs.a = 0.f;
        }
        if (sx == psc(w) - 2)
        {
            sx = psc(w) - 3;
            coeffs.a = coeffs.b + coeffs.a;
            coeffs.b = coeffs.g;
            coeffs.g = coeffs.r;
            coeffs.r = 0.f;
        }
        if (sx >= psc(w) - 1)
        {
            sx = psc(w) - 3;
            coeffs.a = 1.f - coeffs.r;
            coeffs.b = coeffs.r;
            coeffs.g = 0.f;
            coeffs.r = 0.f;
        }
    }

    buffer_st4(alpha_blob_data, gx, afpvec4(coeffs));

    xofs_blob_data[gx] = sx;
}
