#version 460

#extension GL_GOOGLE_include_directive : require
#include "vulkan_activation.comp"

#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_QCOM_cooperative_matrix_conversion : require

layout(constant_id = 0) const int bias_term = 0;
layout(constant_id = 1) const int activation_type = 0;
layout(constant_id = 2) const float activation_param_0 = 0;
layout(constant_id = 3) const float activation_param_1 = 0;
layout(constant_id = 4) const uint M = 1;
layout(constant_id = 5) const uint N = 1;
layout(constant_id = 6) const uint K = 1;
layout(constant_id = 7) const uint subgroup_size = 32;
layout(constant_id = 8) const uint UNROLL_SG_M = 2;
layout(constant_id = 9) const uint UNROLL_SG_N = 2;
layout(constant_id = 10) const uint UNROLL_SG_K = 2;
layout(constant_id = 11) const uint UNROLL_WG_M = 2;
layout(constant_id = 12) const uint UNROLL_WG_N = 2;
layout(constant_id = 13) const uint inch = 1;
layout(constant_id = 14) const uint outch = 1;
layout(constant_id = 15) const uint elempack = 1;
layout(constant_id = 16) const uint out_elempack = 1;

#define shape_constant_id_offset 17
layout(constant_id = shape_constant_id_offset + 0) const uint size = 0;
layout(constant_id = shape_constant_id_offset + 1) const uint cstep = 0;
layout(constant_id = shape_constant_id_offset + 2) const uint outcstep = 0;

layout(binding = 0) readonly buffer bottom_blob { uvec2 bottom_blob_data[]; };
layout(binding = 1) writeonly buffer top_blob { uvec2 top_blob_data[]; };
layout(binding = 2) readonly buffer weight_blob { uvec2 weight_data[]; };
layout(binding = 3) readonly buffer bias_blob { uvec2 bias_data[]; };
layout(binding = 4) readonly buffer bottom_blob_scalar { sfp bottom_blob_data_1[]; };
layout(binding = 5) writeonly buffer top_blob_scalar { sfp top_blob_data_1[]; };

layout(push_constant) uniform parameter
{
    uint size;
    uint cstep;
    uint outcstep;
} p;

float16_t unpack_scalar(uvec2 v, uint i)
{
    return float16_t(unpackHalf2x16(v[i / 2])[i % 2]);
}

// each invocation supplies one row of a and one column of b
void main()
{
#if ncnn_vendorID == 0x5143
    // retain the adreno cooperative matrix lane index workaround
    const uint si = gl_LocalInvocationID.x % subgroup_size;
    const uint sgi = gl_LocalInvocationID.x / subgroup_size;
#else
    const uint si = gl_SubgroupInvocationID;
    const uint sgi = gl_SubgroupID;
#endif
    const uint sgmi = sgi / UNROLL_WG_N;
    const uint sgni = sgi % UNROLL_WG_N;
    const uint output_size = psc(size);
    const uint wgnn = (outch + N * UNROLL_SG_N * UNROLL_WG_N - 1) / (N * UNROLL_SG_N * UNROLL_WG_N);
    const uint wgmi = gl_WorkGroupID.x / wgnn;
    const uint wgni = gl_WorkGroupID.x % wgnn;
    const uint mi = (wgmi * UNROLL_WG_M + sgmi) * UNROLL_SG_M;
    const uint ni = (wgni * UNROLL_WG_N + sgni) * UNROLL_SG_N;
    if (wgmi * M * UNROLL_SG_M * UNROLL_WG_M >= output_size)
        return;

    const uint maxk = 1;
    const uint kk = (inch * maxk + K - 1) / K;
    coopmat<afp, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator> sum[UNROLL_SG_N][UNROLL_SG_M];
    [[unroll]] for (uint zn = 0; zn < UNROLL_SG_N; zn++)
    {
        afp values[N];
        [[unroll]] for (uint j = 0; j < N; j++)
        {
            const uint gn = (ni + zn) * N + j;
            values[j] = afp(bias_term != 0 && gn < outch ? unpack_scalar(bias_data[gn / 4], gn % 4) : float16_t(0));
        }
        [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
            vectorToCoopmatQCOM(values, sum[zn][zm]);
    }

    for (uint k = 0; k < kk; k++)
    {
        coopmat<float16_t, gl_ScopeSubgroup, M, K, gl_MatrixUseA> a[UNROLL_SG_M];
        coopmat<float16_t, gl_ScopeSubgroup, K, N, gl_MatrixUseB> b[UNROLL_SG_N];
        [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
        {
            const uint gm = (mi + zm) * M + si;
            float16_t row[K];
            [[unroll]] for (uint j = 0; j < K; j++)
            {
                const uint gk = k * K + j;
                const uint channel = elempack == 1 ? gk / maxk : (gk / 4 / maxk) * 4 + gk % 4;
                const uint kernel = elempack == 1 ? gk % maxk : (gk / 4) % maxk;
                const uint pos = gm;
                row[j] = float16_t(0);
                if (si < M && gm < output_size && channel < inch && pos < psc(cstep))
                {
                    if (elempack == 1)
                    {
                        const uint offset = channel * psc(cstep) + pos;
                        row[j] = float16_t(buffer_ld1(bottom_blob_data_1, offset));
                    }
                    else
                    {
                        const uint offset = (channel / 4) * psc(cstep) + pos;
                        row[j] = unpack_scalar(bottom_blob_data[offset], channel % 4);
                    }
                }
            }
            vectorToCoopmatQCOM(row, a[zm]);
        }

        // retain the existing unrolled weight packing, including its k tail
        const uint tile_size = N * K * UNROLL_SG_N;
        const uint weight_offset = (k < kk / UNROLL_SG_K * UNROLL_SG_K
                                        ? wgni * kk * UNROLL_WG_N * tile_size + ((k / UNROLL_SG_K) * UNROLL_WG_N + sgni) * tile_size * UNROLL_SG_K + (k % UNROLL_SG_K) * tile_size
                                        : ((wgni * kk + k) * UNROLL_WG_N + sgni) * tile_size);
        [[unroll]] for (uint zn = 0; zn < UNROLL_SG_N; zn++)
        {
            float16_t column[K];
            [[unroll]] for (uint j = 0; j < K; j++)
            {
                const uint offset = weight_offset + zn * N * K + j * N + si;
                column[j] = si < N ? unpack_scalar(weight_data[offset / 4], offset % 4) : float16_t(0);
            }
            vectorToCoopmatQCOM(column, b[zn]);
        }
        [[unroll]] for (uint zn = 0; zn < UNROLL_SG_N; zn++)
            [[unroll]]
            for (uint zm = 0; zm < UNROLL_SG_M; zm++)
                sum[zn][zm] = coopMatMulAdd(a[zm], b[zn], sum[zn][zm]);
    }

    [[unroll]] for (uint zn = 0; zn < UNROLL_SG_N; zn++)
    {
        [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
        {
            afp row[N];
            coopmatToVectorQCOM(sum[zn][zm], row);
            const uint gm = (mi + zm) * M + si;
            if (out_elempack == 1)
            {
                [[unroll]] for (uint j = 0; j < N; j++)
                {
                    const uint gn = (ni + zn) * N + j;
                    // match the original fp16 intermediate before activation
                    const float v = si < M ? float(float16_t(row[j])) : 0.f;
                    if (si < M && gm < output_size && gn < outch)
                    {
                        afpvec4 values = afpvec4(v);
                        values = activation_afpvec4(values, activation_type, activation_param_0, activation_param_1);
                        buffer_st1(top_blob_data_1, gn * psc(outcstep) + gm, values.x);
                    }
                }
            }
            else
            {
                if (si < M && gm < psc(outcstep))
                {
                    [[unroll]] for (uint j = 0; j < N; j += 4)
                    {
                        const uint gn = (ni + zn) * N + j;
                        if (gn < outch)
                        {
                            afpvec4 values = afpvec4(float16_t(row[j]), float16_t(row[j + 1]), float16_t(row[j + 2]), float16_t(row[j + 3]));
                            values = activation_afpvec4(values, activation_type, activation_param_0, activation_param_1);
                            const uint offset = (gn / 4) * psc(outcstep) + gm;
                            top_blob_data[offset] = uvec2(packHalf2x16(vec2(values.xy)), packHalf2x16(vec2(values.zw)));
                        }
                    }
                }
            }
        }
    }
}
