#version 450

#extension GL_GOOGLE_include_directive : enable
#include "vulkan_activation.comp"

layout(constant_id = 0) const int bias_term = 0;
layout(constant_id = 1) const int activation_type = 0;
layout(constant_id = 2) const float activation_param_0 = 0;
layout(constant_id = 3) const float activation_param_1 = 0;
layout(constant_id = 4) const int c = 0;

#define shape_constant_id_offset 5
layout(constant_id = shape_constant_id_offset + 0) const int cstep = 0;

layout(constant_id = shape_constant_id_offset + 1) const int block_x = 0;
layout(constant_id = shape_constant_id_offset + 2) const int block_y = 0;
layout(constant_id = shape_constant_id_offset + 3) const int block_z = 0;

layout(constant_id = shape_constant_id_offset + 4) const int outw = 0;
layout(constant_id = shape_constant_id_offset + 5) const int outh = 0;
layout(constant_id = shape_constant_id_offset + 6) const int outd = 0;
layout(constant_id = shape_constant_id_offset + 7) const int outcstep = 0;

layout(binding = 0) readonly buffer top_tm_blob { sfp top_tm_blob_data[]; };
layout(binding = 1) writeonly buffer top_blob { sfp top_blob_data[]; };
layout(binding = 2) readonly buffer bias_blob { sfp bias_data[]; };

layout(push_constant) uniform parameter
{
    int cstep;

    int block_x;
    int block_y;
    int block_z;

    int outw;
    int outh;
    int outd;
    int outcstep;
} p;

// A^T t A of one depth-transformed 4x4 tile, t index = x * 4 + y
void transform_tile(const afp t[16], out afp o00, out afp o01, out afp o10, out afp o11)
{
    // const float itm[2][4] = {
    //     {1.0f,  1.0f,  1.0f,  0.0f},
    //     {0.0f,  1.0f, -1.0f,  1.0f}
    // };

    // implicit transpose
    afp m00 = t[0] + t[1] + t[2];
    afp m01 = t[4] + t[5] + t[6];
    afp m02 = t[8] + t[9] + t[10];
    afp m03 = t[12] + t[13] + t[14];

    afp m10 = t[1] - t[2] + t[3];
    afp m11 = t[5] - t[6] + t[7];
    afp m12 = t[9] - t[10] + t[11];
    afp m13 = t[13] - t[14] + t[15];

    o00 = m00 + m01 + m02;
    o10 = m10 + m11 + m12;

    o01 = m01 - m02 + m03;
    o11 = m11 - m12 + m13;
}

void main()
{
    int gx = int(gl_GlobalInvocationID.x);
    int gy = int(gl_GlobalInvocationID.y);
    int gz = int(gl_GlobalInvocationID.z);

    if (gx >= psc(block_x) || gy >= psc(block_y) * psc(block_z) || gz >= c)
        return;

    // load 64, coefficient index = (x * 4 + y) * 4 + z
    int v_tm_offset = gz * psc(cstep) + gy * psc(block_x) + gx;

    // transform along d first
    // z0 = k0 + k1 + k2    z1 = k1 - k2 + k3
    afp t0[16];
    afp t1[16];

    for (int i = 0; i < 16; i++)
    {
        afp v0 = buffer_ld1(top_tm_blob_data, v_tm_offset + (i * 4 + 0) * psc(cstep) * c);
        afp v1 = buffer_ld1(top_tm_blob_data, v_tm_offset + (i * 4 + 1) * psc(cstep) * c);
        afp v2 = buffer_ld1(top_tm_blob_data, v_tm_offset + (i * 4 + 2) * psc(cstep) * c);
        afp v3 = buffer_ld1(top_tm_blob_data, v_tm_offset + (i * 4 + 3) * psc(cstep) * c);

        t0[i] = v0 + v1 + v2;
        t1[i] = v1 - v2 + v3;
    }

    // sum index = z y x
    afp sum000;
    afp sum001;
    afp sum010;
    afp sum011;
    afp sum100;
    afp sum101;
    afp sum110;
    afp sum111;

    transform_tile(t0, sum000, sum001, sum010, sum011);
    transform_tile(t1, sum100, sum101, sum110, sum111);

    if (bias_term == 1)
    {
        const afp bias_value = buffer_ld1(bias_data, gz);

        sum000 += bias_value;
        sum001 += bias_value;
        sum010 += bias_value;
        sum011 += bias_value;
        sum100 += bias_value;
        sum101 += bias_value;
        sum110 += bias_value;
        sum111 += bias_value;
    }

    sum000 = activation_afp(sum000, activation_type, activation_param_0, activation_param_1);
    sum001 = activation_afp(sum001, activation_type, activation_param_0, activation_param_1);
    sum010 = activation_afp(sum010, activation_type, activation_param_0, activation_param_1);
    sum011 = activation_afp(sum011, activation_type, activation_param_0, activation_param_1);
    sum100 = activation_afp(sum100, activation_type, activation_param_0, activation_param_1);
    sum101 = activation_afp(sum101, activation_type, activation_param_0, activation_param_1);
    sum110 = activation_afp(sum110, activation_type, activation_param_0, activation_param_1);
    sum111 = activation_afp(sum111, activation_type, activation_param_0, activation_param_1);

    // store 2x2x2
    int x = gx * 2;
    int y = gy % psc(block_y) * 2;
    int z = gy / psc(block_y) * 2;

    int v_offset_0 = gz * psc(outcstep) + (z * psc(outh) + y) * psc(outw) + x;
    int v_offset_1 = v_offset_0 + psc(outw);

    buffer_st1(top_blob_data, v_offset_0 + 0, sum000);
    if (x + 1 < psc(outw)) buffer_st1(top_blob_data, v_offset_0 + 1, sum001);
    if (y + 1 < psc(outh)) buffer_st1(top_blob_data, v_offset_1 + 0, sum010);
    if (y + 1 < psc(outh) && x + 1 < psc(outw)) buffer_st1(top_blob_data, v_offset_1 + 1, sum011);

    if (z + 1 < psc(outd))
    {
        v_offset_0 += psc(outh) * psc(outw);
        v_offset_1 += psc(outh) * psc(outw);

        buffer_st1(top_blob_data, v_offset_0 + 0, sum100);
        if (x + 1 < psc(outw)) buffer_st1(top_blob_data, v_offset_0 + 1, sum101);
        if (y + 1 < psc(outh)) buffer_st1(top_blob_data, v_offset_1 + 0, sum110);
        if (y + 1 < psc(outh) && x + 1 < psc(outw)) buffer_st1(top_blob_data, v_offset_1 + 1, sum111);
    }
}
