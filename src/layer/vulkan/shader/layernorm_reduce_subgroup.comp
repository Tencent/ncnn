#version 450

#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(binding = 0) readonly buffer bottom_top_blob { sfp bottom_top_blob_data[]; };
layout(binding = 1) writeonly buffer mean_blob { float mean_data[]; };
layout(binding = 2) writeonly buffer var_blob { float var_data[]; };

layout(push_constant) uniform parameter
{
    int group_size;
    int num_groups_per_channel;
    int cstep;
} p;

void main()
{
    const int tid = int(gl_LocalInvocationID.x);
    const uint group = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (group >= uint(p.num_groups_per_channel))
        return;

    const int gz = int(gl_WorkGroupID.z);
    const int gy = int(group);
    const int group_id = gz * p.num_groups_per_channel + gy;
    const int offset = gz * p.cstep + gy * p.group_size;
    const float area = float(p.group_size);

    // keep the common offset out of the sum and compensate rounding in long groups
    const float center = float(buffer_ld1(bottom_top_blob_data, offset));
    precise float sum = 0.f;
    precise float correction = 0.f;
    for (int t = tid; t < p.group_size; t += ncnn_subgroupSize)
    {
        const float v = float(buffer_ld1(bottom_top_blob_data, offset + t)) - center;
        precise float y = v - correction;
        precise float next_sum = sum + y;
        correction = (next_sum - sum) - y;
        sum = next_sum;
    }

    const float mean = center + subgroupAdd(sum) / area;
    if (subgroupElect())
    {
        mean_data[group_id] = mean;
    }

    float sqsum = 0.f;
    for (int t = tid; t < p.group_size; t += ncnn_subgroupSize)
    {
        const float d = float(buffer_ld1(bottom_top_blob_data, offset + t)) - mean;
        sqsum += d * d;
    }

    const float variance = subgroupAdd(sqsum) / area;
    if (subgroupElect())
    {
        var_data[group_id] = variance;
    }
}
