#version 460

#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_QCOM_cooperative_matrix_conversion : require

layout(constant_id = 0) const int attn_mask = 0;

layout(constant_id = 1 + 0) const uint M = 1;
layout(constant_id = 1 + 1) const uint N = 1;
layout(constant_id = 1 + 2) const uint K = 1;
layout(constant_id = 1 + 3) const uint subgroup_size = 32;
layout(constant_id = 1 + 4) const uint UNROLL_SG_M = 2;
layout(constant_id = 1 + 5) const uint UNROLL_WG_M = 2;
layout(constant_id = 1 + 6) const uint MAX_OUT_CHUNKS = 8;
layout(constant_id = 1 + 7) const uint UNROLL_P_N = 4;

layout(binding = 0) readonly buffer Q_blob { uvec4 Q_blob_data[]; };
layout(binding = 1) readonly buffer K_blob { uvec4 K_blob_data[]; };
layout(binding = 2) readonly buffer V_blob { uvec4 V_blob_data[]; };
layout(binding = 3) writeonly buffer top_blob { uvec4 top_blob_data[]; };
layout(binding = 4) readonly buffer mask_blob { sfp mask_blob_data[]; };

layout(push_constant) uniform parameter
{
    float scale;
    int src_seqlen;
    int dst_seqlen;
    int embed_dim;
    int out_embed_dim;
    int num_heads;
    int attn_mask_dims;
    int num_heads_per_group;
    int Q_cstep;
    int K_cstep;
    int V_cstep;
    int out_cstep;
    int mask_cstep;
} p;

uint load_q_bits(uint i)
{
    return (Q_blob_data[i / 8][(i % 8) / 2] >> ((i % 2) * 16)) & 65535u;
}

uint load_k_bits(uint i)
{
    return (K_blob_data[i / 8][(i % 8) / 2] >> ((i % 2) * 16)) & 65535u;
}

uint load_v_bits(uint i)
{
    return (V_blob_data[i / 8][(i % 8) / 2] >> ((i % 2) * 16)) & 65535u;
}

void main()
{
    const uint gz = gl_GlobalInvocationID.z;
    if (gz >= uint(p.num_heads))
        return;

#if ncnn_vendorID == 0x5143
    // retain the adreno cooperative matrix lane index workaround
    const uint si = gl_LocalInvocationID.x % subgroup_size;
    const uint sgi = gl_LocalInvocationID.x / subgroup_size;
#else
    const uint si = gl_SubgroupInvocationID;
    const uint sgi = gl_SubgroupID;
#endif
    const uint mi = (gl_WorkGroupID.x * UNROLL_WG_M + sgi) * UNROLL_SG_M;
    const uint kv_head = gz / uint(p.num_heads_per_group);
    const uint kk = (uint(p.embed_dim) + K - 1) / K;
    const uint nn = (uint(p.dst_seqlen) + N - 1) / N;

    // each lane owns one query row, including its online softmax statistics
    float row_max[UNROLL_SG_M];
    float row_sum[UNROLL_SG_M];
    uint output_rows[MAX_OUT_CHUNKS][UNROLL_SG_M][N];
    [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
    {
        row_max[zm] = -3.402823e+38f;
        row_sum[zm] = 0.f;
        [[unroll]] for (uint c = 0; c < MAX_OUT_CHUNKS; c++)
            [[unroll]]
            for (uint r = 0; r < N; r++)
                output_rows[c][zm][r] = 0u;
    }

    for (uint jt = 0; jt < nn; jt++)
    {
        coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator> scores[UNROLL_SG_M];
        [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
            scores[zm] = coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator>(0.f);

        for (uint kt = 0; kt < kk; kt++)
        {
            uint key_column[8];
            [[unroll]] for (uint word = 0; word < 8; word++)
            {
                uint packed_word = 0u;
                [[unroll]] for (uint component = 0; component < 2; component++)
                {
                    const uint r = word * 2 + component;
                    uint bits = 0u;
                    const uint gn = jt * N + si;
                    const uint gk = kt * K + r;
                    bits = 0u;
                    if (si < N && gn < uint(p.dst_seqlen) && gk < uint(p.embed_dim))
                        bits = load_k_bits(kv_head * uint(p.K_cstep) + gn * uint(p.embed_dim) + gk);

                    packed_word |= (bits & 65535u) << (component * 16);
                }
                key_column[word] = packed_word;
            }
            coopmat<float16_t, gl_ScopeSubgroup, K, N, gl_MatrixUseB> key;
            vectorToCoopmatQCOM(key_column, key);
            [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
            {
                const uint gm = (mi + zm) * M + si;
                uint query_row[8];
                [[unroll]] for (uint word = 0; word < 8; word++)
                {
                    uint packed_word = 0u;
                    [[unroll]] for (uint component = 0; component < 2; component++)
                    {
                        const uint r = word * 2 + component;
                        uint bits = 0u;
                        const uint gk = kt * K + r;
                        bits = 0u;
                        if (si < M && gm < uint(p.src_seqlen) && gk < uint(p.embed_dim))
                            bits = load_q_bits(gz * uint(p.Q_cstep) + gm * uint(p.embed_dim) + gk);

                        packed_word |= (bits & 65535u) << (component * 16);
                    }
                    query_row[word] = packed_word;
                }
                coopmat<float16_t, gl_ScopeSubgroup, M, K, gl_MatrixUseA> query;
                vectorToCoopmatQCOM(query_row, query);
                scores[zm] = coopMatMulAdd(query, key, scores[zm]);
            }
        }

        coopmat<float16_t, gl_ScopeSubgroup, M, K, gl_MatrixUseA> probabilities[UNROLL_SG_M];
        float correction[UNROLL_SG_M];
        [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
        {
            const uint gm = (mi + zm) * M + si;
            uint values[N];
            coopmatToVectorQCOM(scores[zm], values);
            float maximum = row_max[zm];
            [[unroll]] for (uint r = 0; r < N; r++)
            {
                const uint gn = jt * N + r;
                if (si < M && gm < uint(p.src_seqlen) && gn < uint(p.dst_seqlen))
                {
                    float score = uintBitsToFloat(values[r]) * p.scale;
                    if (attn_mask == 1)
                    {
                        const uint mask_head = p.attn_mask_dims == 3 ? gz : 0;
                        score += float(buffer_ld1(mask_blob_data, mask_head * uint(p.mask_cstep) + gm * uint(p.dst_seqlen) + gn));
                    }
                    maximum = max(maximum, score);
                    values[r] = floatBitsToUint(score);
                }
                else
                    values[r] = floatBitsToUint(-3.402823e+38f);
            }
            correction[zm] = exp(row_max[zm] - maximum);
            row_max[zm] = maximum;
            float total = 0.f;
            uint probability_row[8];
            // The flash attention pipeline requires N == K == 16.
            [[unroll]] for (uint word = 0; word < 8; word++)
            {
                vec2 values_pair = vec2(0.f);
                [[unroll]] for (uint component = 0; component < 2; component++)
                {
                    const uint r = word * 2 + component;
                    float value = 0.f;
                    if (si < M && gm < uint(p.src_seqlen) && jt * N + r < uint(p.dst_seqlen))
                        value = exp(uintBitsToFloat(values[r]) - maximum);
                    total += value;
                    values_pair[component] = value;
                }
                probability_row[word] = packHalf2x16(values_pair);
            }
            row_sum[zm] = row_sum[zm] * correction[zm] + total;
            vectorToCoopmatQCOM(probability_row, probabilities[zm]);
        }

        for (uint c = 0; c < MAX_OUT_CHUNKS; c++)
        {
            uint value_column[8];
            [[unroll]] for (uint word = 0; word < 8; word++)
            {
                uint packed_word = 0u;
                [[unroll]] for (uint component = 0; component < 2; component++)
                {
                    const uint r = word * 2 + component;
                    uint bits = 0u;
                    const uint gn = jt * N + r;
                    const uint gc = c * N + si;
                    bits = 0u;
                    if (si < N && gn < uint(p.dst_seqlen) && gc < uint(p.out_embed_dim))
                        bits = load_v_bits(kv_head * uint(p.V_cstep) + gn * uint(p.out_embed_dim) + gc);

                    packed_word |= (bits & 65535u) << (component * 16);
                }
                value_column[word] = packed_word;
            }
            coopmat<float16_t, gl_ScopeSubgroup, K, N, gl_MatrixUseB> value;
            vectorToCoopmatQCOM(value_column, value);
            [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
            {
                uint output_row[N];
                [[unroll]] for (uint r = 0; r < N; r++)
                    output_row[r] = floatBitsToUint(uintBitsToFloat(output_rows[c][zm][r]) * correction[zm]);
                coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator> output_matrix;
                vectorToCoopmatQCOM(output_row, output_matrix);
                output_matrix = coopMatMulAdd(probabilities[zm], value, output_matrix);
                coopmatToVectorQCOM(output_matrix, output_row);
                [[unroll]] for (uint r = 0; r < N; r++)
                    output_rows[c][zm][r] = output_row[r];
            }
        }
    }

    for (uint c = 0; c < MAX_OUT_CHUNKS; c++)
    {
        [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
        {
            const uint gm = (mi + zm) * M + si;
            if (si < M && gm < uint(p.src_seqlen))
            {
                const float inv_sum = 1.f / row_sum[zm];
                [[unroll]] for (uint r = 0; r < N; r += 8)
                {
                    if (c * N + r < uint(p.out_embed_dim))
                    {
                        uvec4 packed;
                        [[unroll]] for (uint t = 0; t < 4; t++)
                            packed[t] = packHalf2x16(vec2(uintBitsToFloat(output_rows[c][zm][r + t * 2]), uintBitsToFloat(output_rows[c][zm][r + t * 2 + 1])) * inv_sum);
                        top_blob_data[(gz * uint(p.out_cstep) + gm * uint(p.out_embed_dim) + c * N + r) / 8] = packed;
                    }
                }
            }
        }
    }
}
