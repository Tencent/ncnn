#version 450

#extension GL_EXT_control_flow_attributes : require

#extension GL_KHR_shader_subgroup_basic : require

#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#if ncnn_VK_KHR_cooperative_matrix
#extension GL_KHR_cooperative_matrix : require
#elif ncnn_VK_NV_cooperative_matrix
#extension GL_NV_cooperative_matrix : require
#endif

#if ncnn_vendorID == 0x5143 || ncnn_vendorID == 0x13b5
// adreno and mali need stride * 2 for packed fp16 loads
#define coopmat_fp16_stride(v) ((v) * 2)
#else
#define coopmat_fp16_stride(v) (v)
#endif

layout(constant_id = 0) const float alpha = 1.f;
layout(constant_id = 1) const float beta = 1.f;
layout(constant_id = 2) const int transA = 0;
layout(constant_id = 3) const int transB = 0;
layout(constant_id = 4) const int constantA = 0;
layout(constant_id = 5) const int constantB = 0;
layout(constant_id = 6) const int output_transpose = 0;
layout(constant_id = 7) const int GM = 0;
layout(constant_id = 8) const int GN = 0;
layout(constant_id = 9) const int GK = 0;
layout(constant_id = 10) const int out_elempack = 0;

layout(constant_id = 11 + 0) const uint M = 1;
layout(constant_id = 11 + 1) const uint N = 1;
layout(constant_id = 11 + 2) const uint K = 1;
layout(constant_id = 11 + 3) const uint subgroup_size = 32;
layout(constant_id = 11 + 4) const uint UNROLL_SG_M = 2;
layout(constant_id = 11 + 5) const uint UNROLL_SG_N = 2;
layout(constant_id = 11 + 6) const uint UNROLL_SG_K = 2;
layout(constant_id = 11 + 7) const uint UNROLL_WG_M = 2;
layout(constant_id = 11 + 8) const uint UNROLL_WG_N = 2;

layout(binding = 0) buffer top_blob { sfp top_blob_data[]; };
layout(binding = 1) writeonly buffer top_blob_4 { sfpvec4 top_blob_data_4[]; };
// fp16 tiles in the gemm_cm constant layout, prescaled by 2^-scale per A row and B column
layout(binding = 2) readonly buffer A_blob { uvec2 A_blob_data[]; };
layout(binding = 3) readonly buffer B_blob { uvec2 B_blob_data[]; };
layout(binding = 4) readonly buffer C_blob { sfp C_blob_data[]; };
layout(binding = 5) readonly buffer A_scales_blob { int A_scales_data[]; };
layout(binding = 6) readonly buffer B_scales_blob { int B_scales_data[]; };
// original bf16 dynamic inputs for the fp32 fallback
layout(binding = 7) readonly buffer A_bf16_blob { sfp A_bf16_blob_data[]; };
layout(binding = 8) readonly buffer B_bf16_blob { sfp B_bf16_blob_data[]; };

layout(push_constant) uniform parameter
{
    int GM;
    int GN;
    int GK;
    int broadcast_type_C;
    int A_hstep;
    int B_hstep;
    int A_elempack;
    int B_elempack;
    int outhstep;
    int out_elempack;
} p;

const uint Md4 = M / 4;
const uint Nd4 = N / 4;
const uint Kd4 = K / 4;

shared uvec2 tmp_a[UNROLL_WG_M][UNROLL_SG_K * UNROLL_SG_M * M * Kd4];
shared uvec2 tmp_b[UNROLL_WG_N][UNROLL_SG_K * UNROLL_SG_N * K * Nd4];
shared float tmp_o[UNROLL_WG_N * UNROLL_WG_M][UNROLL_SG_N * UNROLL_SG_M * M * N];
shared int tmp_sa[UNROLL_WG_M * UNROLL_SG_M * M];
shared int tmp_sb[UNROLL_WG_N * UNROLL_SG_N * N];
shared int tmp_fallback_count;
// local row and column of outputs that need fp32, a longer list switches to the fp32 tile
shared uint tmp_fallback_list[subgroup_size * UNROLL_WG_M * UNROLL_WG_N * 2];

// the fp32 fallback reuses tmp_a and tmp_b as BM x KC and KC x BN fp32 chunks of uvec2 pairs
// macros instead of functions, nvidia 535 miscompiles the cooperative matrix loads
// when another function also accesses these shared arrays
const uint BM = UNROLL_WG_M * UNROLL_SG_M * M;
const uint BN = UNROLL_WG_N * UNROLL_SG_N * N;
const uint KC = UNROLL_SG_K * K / 2;
const uint tmp_a_row = UNROLL_SG_K * UNROLL_SG_M * M * Kd4;
const uint tmp_b_row = UNROLL_SG_K * UNROLL_SG_N * K * Nd4;

#define store_fallback_a(f2, v) tmp_a[(f2) / tmp_a_row][(f2) % tmp_a_row] = floatBitsToUint(v)
#define load_fallback_a(f2)     uintBitsToFloat(tmp_a[(f2) / tmp_a_row][(f2) % tmp_a_row])
#define store_fallback_b(f2, v) tmp_b[(f2) / tmp_b_row][(f2) % tmp_b_row] = floatBitsToUint(v)
#define load_fallback_b(f2)     uintBitsToFloat(tmp_b[(f2) / tmp_b_row][(f2) % tmp_b_row])

float scale_pow2(int s)
{
    return uintBitsToFloat(uint(clamp(s, -112, 112) + 127) << 23);
}

float restore_scale(float v, int s)
{
    const int s0 = clamp(s, -112, 112);
    // Apply the remainder first to avoid double rounding near underflow.
    if (s != s0)
        v *= scale_pow2(s - s0);
    return v * scale_pow2(s0);
}

// element offset of row r and depth k in the tiles packed by create_pipeline and gemm_bf16s_cm_pack
uint packed_offset(uint r, uint k, uint R, uint SG_R, uint WG_R, bool kmajor)
{
    const uint kk = (psc(GK) + K - 1) / K;
    const uint kfull = kk / UNROLL_SG_K * UNROLL_SG_K;

    const uint rr = r % (R * SG_R * WG_R);
    const uint wr = rr / (R * SG_R);
    const uint zr = (rr / R) % SG_R;
    const uint ri = rr % R;
    const uint kb = k / K;
    const uint kj = k % K;
    const uint zk = kb % UNROLL_SG_K;

    // full UNROLL_SG_K groups first, then single k steps
    const uint g = kb < kfull ? (kb - zk) * WG_R + wr * UNROLL_SG_K + zk : kb * WG_R + wr;
    const uint tile = kmajor ? (zr * K + kj) * R + ri : (zr * R + ri) * K + kj;

    return ((r / (R * SG_R * WG_R)) * kk * WG_R + g) * (SG_R * R * K) + tile;
}

float load_a(int i, int k)
{
    if (constantA == 1)
    {
        // constant rows always fit, so the prescaled value is exact
        const uint offset = packed_offset(uint(i), uint(k), M, UNROLL_SG_M, UNROLL_WG_M, false);
        const float v = unpackHalf2x16(A_blob_data[offset / 4][(offset % 4) / 2])[offset % 2];
        return v * scale_pow2(A_scales_data[i]);
    }

    const int row = transA == 0 ? i : k;
    const int col = transA == 0 ? k : i;
    const int offset = p.A_elempack == 4 ? ((row >> 2) * p.A_hstep + col) * 4 + (row & 3) : row * p.A_hstep + col;
    return float(buffer_ld1(A_bf16_blob_data, offset));
}

float load_b(int k, int j)
{
    if (constantB == 1)
    {
        const uint offset = packed_offset(uint(j), uint(k), N, UNROLL_SG_N, UNROLL_WG_N, true);
        const float v = unpackHalf2x16(B_blob_data[offset / 4][(offset % 4) / 2])[offset % 2];
        return v * scale_pow2(B_scales_data[j]);
    }

    const int row = transB == 0 ? k : j;
    const int col = transB == 0 ? j : k;
    const int offset = p.B_elempack == 4 ? ((row >> 2) * p.B_hstep + col) * 4 + (row & 3) : row * p.B_hstep + col;
    return float(buffer_ld1(B_bf16_blob_data, offset));
}

float load_c(int i, int j)
{
    float v = 0.f;
    if (p.broadcast_type_C == 0)
        v = float(buffer_ld1(C_blob_data, 0));
    if (p.broadcast_type_C == 1 || p.broadcast_type_C == 2)
        v = float(buffer_ld1(C_blob_data, i));
    if (p.broadcast_type_C == 3)
        v = float(buffer_ld1(C_blob_data, i * psc(GN) + j));
    if (p.broadcast_type_C == 4)
        v = float(buffer_ld1(C_blob_data, j));
    return v * beta;
}

float gemm_fp32(int i, int j)
{
    float sum = load_c(i, j);
    int k = 0;
    for (; k + 3 < psc(GK); k += 4)
    {
        // issue the loads together, the sum keeps the C-first k order
        const vec4 a = vec4(load_a(i, k), load_a(i, k + 1), load_a(i, k + 2), load_a(i, k + 3));
        const vec4 b = vec4(load_b(k, j), load_b(k + 1, j), load_b(k + 2, j), load_b(k + 3, j));
        sum = fma(a.r, b.r, sum);
        sum = fma(a.g, b.g, sum);
        sum = fma(a.b, b.b, sum);
        sum = fma(a.a, b.a, sum);
    }
    for (; k < psc(GK); k++)
        sum = fma(load_a(i, k), load_b(k, j), sum);
    return sum;
}

// rows and columns that do not fit fp16 use fp32, and so do nonfinite results,
// because a finite bias can prevent overflow when accumulated before the products
bool needs_fp32(int sa, int sb, float c, float r)
{
    return sa == 256 || sb == 256 || isnan(c) || isinf(c) || isnan(r) || isinf(r);
}

int output_offset(int i, int j)
{
    const int row = output_transpose == 0 ? i : j;
    const int col = output_transpose == 0 ? j : i;
    return psc(out_elempack) == 4 ? ((row >> 2) * p.outhstep + col) * 4 + (row & 3) : row * p.outhstep + col;
}

void main()
{
    const uint wgi = gl_WorkGroupID.x;
#if ncnn_vendorID == 0x5143
    const uint sgi = gl_LocalInvocationID.x / subgroup_size;
    const uint si = gl_LocalInvocationID.x % subgroup_size;
#else
    const uint sgi = gl_SubgroupID;
    const uint si = gl_SubgroupInvocationID;
#endif

    const uint wgmm = (psc(GM) + M * UNROLL_SG_M * UNROLL_WG_M - 1) / (M * UNROLL_SG_M * UNROLL_WG_M);
    const uint wgnn = (psc(GN) + N * UNROLL_SG_N * UNROLL_WG_N - 1) / (N * UNROLL_SG_N * UNROLL_WG_N);

    const uint wgmi = wgi / wgnn;
    const uint wgni = wgi % wgnn;

    const uint sgmi = sgi / UNROLL_WG_N;
    const uint sgni = sgi % UNROLL_WG_N;

    const uint kk = (psc(GK) + K - 1) / K;

    if (wgmi >= wgmm)
        return;

    const uint mi = (wgmi * UNROLL_WG_M + sgmi) * UNROLL_SG_M;
    const uint ni = (wgni * UNROLL_WG_N + sgni) * UNROLL_SG_N;

    const uint li = gl_LocalInvocationID.x;
    const uint local_size = subgroup_size * UNROLL_WG_M * UNROLL_WG_N;

    // stage the row and column scales early, the k loop barriers make them visible
    {
        if (li == 0)
            tmp_fallback_count = 0;

        for (uint t = li; t < UNROLL_WG_M * UNROLL_SG_M * M; t += local_size)
        {
            const uint gm = wgmi * (UNROLL_WG_M * UNROLL_SG_M * M) + t;
            tmp_sa[t] = gm < uint(psc(GM)) ? A_scales_data[gm] : 0;
        }
        for (uint t = li; t < UNROLL_WG_N * UNROLL_SG_N * N; t += local_size)
        {
            const uint gn = wgni * (UNROLL_WG_N * UNROLL_SG_N * N) + t;
            tmp_sb[t] = gn < uint(psc(GN)) ? B_scales_data[gn] : 0;
        }
    }

#if ncnn_VK_KHR_cooperative_matrix
    coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator> sum[UNROLL_SG_N][UNROLL_SG_M];
#elif ncnn_VK_NV_cooperative_matrix
    fcoopmatNV<32, gl_ScopeSubgroup, M, N> sum[UNROLL_SG_N][UNROLL_SG_M];
#endif

    [[unroll]] for (uint zn = 0; zn < UNROLL_SG_N; zn++)
    {
        [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
        {
#if ncnn_VK_KHR_cooperative_matrix
            sum[zn][zm] = coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator>(0.f);
#elif ncnn_VK_NV_cooperative_matrix
            sum[zn][zm] = fcoopmatNV<32, gl_ScopeSubgroup, M, N>(0.f);
#endif
        }
    }

    // the tiles of one subgroup row are loaded cooperatively by the UNROLL_WG_N subgroups sharing it
    const uint Kd4_M_USGM = Kd4 * M * UNROLL_SG_M;
    const uint Nd4_K_USGN = Nd4 * K * UNROLL_SG_N;
    const uint Kd4_M_USGM_USGK = Kd4_M_USGM * UNROLL_SG_K;
    const uint Nd4_K_USGN_USGK = Nd4_K_USGN * UNROLL_SG_K;
    const uint Kd4_M_USGM_USGK_d_subgroupsize = (Kd4_M_USGM_USGK + (subgroup_size * UNROLL_WG_N - 1)) / (subgroup_size * UNROLL_WG_N);
    const uint Nd4_K_USGN_USGK_d_subgroupsize = (Nd4_K_USGN_USGK + (subgroup_size * UNROLL_WG_M - 1)) / (subgroup_size * UNROLL_WG_M);
    const uint Kd4_M_USGM_d_subgroupsize = (Kd4_M_USGM + (subgroup_size * UNROLL_WG_N - 1)) / (subgroup_size * UNROLL_WG_N);
    const uint Nd4_K_USGN_d_subgroupsize = (Nd4_K_USGN + (subgroup_size * UNROLL_WG_M - 1)) / (subgroup_size * UNROLL_WG_M);

    uint k = 0;

    if (kk >= UNROLL_SG_K * 2)
    {
        // local stack and shared memory ping-pong
        uvec2 prefetch_tmp_a[Kd4_M_USGM_USGK_d_subgroupsize];
        uvec2 prefetch_tmp_b[Nd4_K_USGN_USGK_d_subgroupsize];

        // prefetch the very first
        {
            const uint A_offset = (wgmi * kk * UNROLL_WG_M + sgmi * UNROLL_SG_K) * Kd4_M_USGM;
            [[unroll]] for (uint q = 0; q < Kd4_M_USGM_USGK_d_subgroupsize; q++)
            {
                const uint siq = (q * UNROLL_WG_N + sgni) * subgroup_size + si;

                if (Kd4_M_USGM_USGK % (subgroup_size * UNROLL_WG_N) == 0 || siq < Kd4_M_USGM_USGK)
                {
                    prefetch_tmp_a[q] = A_blob_data[A_offset + siq];
                }
            }

            const uint B_offset = (wgni * kk * UNROLL_WG_N + sgni * UNROLL_SG_K) * Nd4_K_USGN;
            [[unroll]] for (uint q = 0; q < Nd4_K_USGN_USGK_d_subgroupsize; q++)
            {
                const uint siq = (q * UNROLL_WG_M + sgmi) * subgroup_size + si;

                if (Nd4_K_USGN_USGK % (subgroup_size * UNROLL_WG_M) == 0 || siq < Nd4_K_USGN_USGK)
                {
                    prefetch_tmp_b[q] = B_blob_data[B_offset + siq];
                }
            }
        }

        k += UNROLL_SG_K;

        for (; k + UNROLL_SG_K - 1 < kk; k += UNROLL_SG_K)
        {
            barrier();

            // copy prefetch to shared memory, the packed layout matches the shared layout
            [[unroll]] for (uint q = 0; q < Kd4_M_USGM_USGK_d_subgroupsize; q++)
            {
                const uint siq = (q * UNROLL_WG_N + sgni) * subgroup_size + si;

                if (Kd4_M_USGM_USGK % (subgroup_size * UNROLL_WG_N) == 0 || siq < Kd4_M_USGM_USGK)
                {
                    tmp_a[sgmi][siq] = prefetch_tmp_a[q];
                }
            }
            [[unroll]] for (uint q = 0; q < Nd4_K_USGN_USGK_d_subgroupsize; q++)
            {
                const uint siq = (q * UNROLL_WG_M + sgmi) * subgroup_size + si;

                if (Nd4_K_USGN_USGK % (subgroup_size * UNROLL_WG_M) == 0 || siq < Nd4_K_USGN_USGK)
                {
                    tmp_b[sgni][siq] = prefetch_tmp_b[q];
                }
            }

            barrier();

            // prefetch the next
            {
                const uint A_offset = (wgmi * kk * UNROLL_WG_M + k * UNROLL_WG_M + sgmi * UNROLL_SG_K) * Kd4_M_USGM;
                [[unroll]] for (uint q = 0; q < Kd4_M_USGM_USGK_d_subgroupsize; q++)
                {
                    const uint siq = (q * UNROLL_WG_N + sgni) * subgroup_size + si;

                    if (Kd4_M_USGM_USGK % (subgroup_size * UNROLL_WG_N) == 0 || siq < Kd4_M_USGM_USGK)
                    {
                        prefetch_tmp_a[q] = A_blob_data[A_offset + siq];
                    }
                }

                const uint B_offset = (wgni * kk * UNROLL_WG_N + k * UNROLL_WG_N + sgni * UNROLL_SG_K) * Nd4_K_USGN;
                [[unroll]] for (uint q = 0; q < Nd4_K_USGN_USGK_d_subgroupsize; q++)
                {
                    const uint siq = (q * UNROLL_WG_M + sgmi) * subgroup_size + si;

                    if (Nd4_K_USGN_USGK % (subgroup_size * UNROLL_WG_M) == 0 || siq < Nd4_K_USGN_USGK)
                    {
                        prefetch_tmp_b[q] = B_blob_data[B_offset + siq];
                    }
                }
            }

            [[unroll]] for (uint zk = 0; zk < UNROLL_SG_K; zk++)
            {
#if ncnn_VK_KHR_cooperative_matrix
                coopmat<float16_t, gl_ScopeSubgroup, M, K, gl_MatrixUseA> A[UNROLL_SG_M];
                coopmat<float16_t, gl_ScopeSubgroup, K, N, gl_MatrixUseB> B[UNROLL_SG_N];
#elif ncnn_VK_NV_cooperative_matrix
                fcoopmatNV<16, gl_ScopeSubgroup, M, K> A[UNROLL_SG_M];
                fcoopmatNV<16, gl_ScopeSubgroup, K, N> B[UNROLL_SG_N];
#endif

                [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
                {
#if ncnn_VK_KHR_cooperative_matrix
                    coopMatLoad(A[zm], tmp_a[sgmi], (zk * UNROLL_SG_M + zm) * (Kd4 * M), coopmat_fp16_stride(Kd4), gl_CooperativeMatrixLayoutRowMajor);
#elif ncnn_VK_NV_cooperative_matrix
                    coopMatLoadNV(A[zm], tmp_a[sgmi], (zk * UNROLL_SG_M + zm) * (Kd4 * M), Kd4, false);
#endif
                }

                [[unroll]] for (uint zn = 0; zn < UNROLL_SG_N; zn++)
                {
#if ncnn_VK_KHR_cooperative_matrix
                    coopMatLoad(B[zn], tmp_b[sgni], (zk * UNROLL_SG_N + zn) * (Nd4 * K), coopmat_fp16_stride(Nd4), gl_CooperativeMatrixLayoutRowMajor);
#elif ncnn_VK_NV_cooperative_matrix
                    coopMatLoadNV(B[zn], tmp_b[sgni], (zk * UNROLL_SG_N + zn) * (Nd4 * K), Nd4, false);
#endif
                }

                [[unroll]] for (uint zn = 0; zn < UNROLL_SG_N; zn++)
                {
                    [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
                    {
#if ncnn_VK_KHR_cooperative_matrix
                        sum[zn][zm] = coopMatMulAdd(A[zm], B[zn], sum[zn][zm]);
#elif ncnn_VK_NV_cooperative_matrix
                        sum[zn][zm] = coopMatMulAddNV(A[zm], B[zn], sum[zn][zm]);
#endif
                    }
                }
            }
        }

        barrier();

        // the last copy prefetch to shared memory
        [[unroll]] for (uint q = 0; q < Kd4_M_USGM_USGK_d_subgroupsize; q++)
        {
            const uint siq = (q * UNROLL_WG_N + sgni) * subgroup_size + si;

            if (Kd4_M_USGM_USGK % (subgroup_size * UNROLL_WG_N) == 0 || siq < Kd4_M_USGM_USGK)
            {
                tmp_a[sgmi][siq] = prefetch_tmp_a[q];
            }
        }
        [[unroll]] for (uint q = 0; q < Nd4_K_USGN_USGK_d_subgroupsize; q++)
        {
            const uint siq = (q * UNROLL_WG_M + sgmi) * subgroup_size + si;

            if (Nd4_K_USGN_USGK % (subgroup_size * UNROLL_WG_M) == 0 || siq < Nd4_K_USGN_USGK)
            {
                tmp_b[sgni][siq] = prefetch_tmp_b[q];
            }
        }

        barrier();

        [[unroll]] for (uint zk = 0; zk < UNROLL_SG_K; zk++)
        {
#if ncnn_VK_KHR_cooperative_matrix
            coopmat<float16_t, gl_ScopeSubgroup, M, K, gl_MatrixUseA> A[UNROLL_SG_M];
            coopmat<float16_t, gl_ScopeSubgroup, K, N, gl_MatrixUseB> B[UNROLL_SG_N];
#elif ncnn_VK_NV_cooperative_matrix
            fcoopmatNV<16, gl_ScopeSubgroup, M, K> A[UNROLL_SG_M];
            fcoopmatNV<16, gl_ScopeSubgroup, K, N> B[UNROLL_SG_N];
#endif

            [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
            {
#if ncnn_VK_KHR_cooperative_matrix
                coopMatLoad(A[zm], tmp_a[sgmi], (zk * UNROLL_SG_M + zm) * (Kd4 * M), coopmat_fp16_stride(Kd4), gl_CooperativeMatrixLayoutRowMajor);
#elif ncnn_VK_NV_cooperative_matrix
                coopMatLoadNV(A[zm], tmp_a[sgmi], (zk * UNROLL_SG_M + zm) * (Kd4 * M), Kd4, false);
#endif
            }

            [[unroll]] for (uint zn = 0; zn < UNROLL_SG_N; zn++)
            {
#if ncnn_VK_KHR_cooperative_matrix
                coopMatLoad(B[zn], tmp_b[sgni], (zk * UNROLL_SG_N + zn) * (Nd4 * K), coopmat_fp16_stride(Nd4), gl_CooperativeMatrixLayoutRowMajor);
#elif ncnn_VK_NV_cooperative_matrix
                coopMatLoadNV(B[zn], tmp_b[sgni], (zk * UNROLL_SG_N + zn) * (Nd4 * K), Nd4, false);
#endif
            }

            [[unroll]] for (uint zn = 0; zn < UNROLL_SG_N; zn++)
            {
                [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
                {
#if ncnn_VK_KHR_cooperative_matrix
                    sum[zn][zm] = coopMatMulAdd(A[zm], B[zn], sum[zn][zm]);
#elif ncnn_VK_NV_cooperative_matrix
                    sum[zn][zm] = coopMatMulAddNV(A[zm], B[zn], sum[zn][zm]);
#endif
                }
            }
        }
    }
    else if (kk >= UNROLL_SG_K)
    {
        // no ping-pong version
        const uint A_offset = (wgmi * kk * UNROLL_WG_M + sgmi * UNROLL_SG_K) * Kd4_M_USGM;
        [[unroll]] for (uint q = 0; q < Kd4_M_USGM_USGK_d_subgroupsize; q++)
        {
            const uint siq = (q * UNROLL_WG_N + sgni) * subgroup_size + si;

            if (Kd4_M_USGM_USGK % (subgroup_size * UNROLL_WG_N) == 0 || siq < Kd4_M_USGM_USGK)
            {
                tmp_a[sgmi][siq] = A_blob_data[A_offset + siq];
            }
        }

        const uint B_offset = (wgni * kk * UNROLL_WG_N + sgni * UNROLL_SG_K) * Nd4_K_USGN;
        [[unroll]] for (uint q = 0; q < Nd4_K_USGN_USGK_d_subgroupsize; q++)
        {
            const uint siq = (q * UNROLL_WG_M + sgmi) * subgroup_size + si;

            if (Nd4_K_USGN_USGK % (subgroup_size * UNROLL_WG_M) == 0 || siq < Nd4_K_USGN_USGK)
            {
                tmp_b[sgni][siq] = B_blob_data[B_offset + siq];
            }
        }

        barrier();

        [[unroll]] for (uint zk = 0; zk < UNROLL_SG_K; zk++)
        {
#if ncnn_VK_KHR_cooperative_matrix
            coopmat<float16_t, gl_ScopeSubgroup, M, K, gl_MatrixUseA> A[UNROLL_SG_M];
            coopmat<float16_t, gl_ScopeSubgroup, K, N, gl_MatrixUseB> B[UNROLL_SG_N];
#elif ncnn_VK_NV_cooperative_matrix
            fcoopmatNV<16, gl_ScopeSubgroup, M, K> A[UNROLL_SG_M];
            fcoopmatNV<16, gl_ScopeSubgroup, K, N> B[UNROLL_SG_N];
#endif

            [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
            {
#if ncnn_VK_KHR_cooperative_matrix
                coopMatLoad(A[zm], tmp_a[sgmi], (zk * UNROLL_SG_M + zm) * (Kd4 * M), coopmat_fp16_stride(Kd4), gl_CooperativeMatrixLayoutRowMajor);
#elif ncnn_VK_NV_cooperative_matrix
                coopMatLoadNV(A[zm], tmp_a[sgmi], (zk * UNROLL_SG_M + zm) * (Kd4 * M), Kd4, false);
#endif
            }

            [[unroll]] for (uint zn = 0; zn < UNROLL_SG_N; zn++)
            {
#if ncnn_VK_KHR_cooperative_matrix
                coopMatLoad(B[zn], tmp_b[sgni], (zk * UNROLL_SG_N + zn) * (Nd4 * K), coopmat_fp16_stride(Nd4), gl_CooperativeMatrixLayoutRowMajor);
#elif ncnn_VK_NV_cooperative_matrix
                coopMatLoadNV(B[zn], tmp_b[sgni], (zk * UNROLL_SG_N + zn) * (Nd4 * K), Nd4, false);
#endif
            }

            [[unroll]] for (uint zn = 0; zn < UNROLL_SG_N; zn++)
            {
                [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
                {
#if ncnn_VK_KHR_cooperative_matrix
                    sum[zn][zm] = coopMatMulAdd(A[zm], B[zn], sum[zn][zm]);
#elif ncnn_VK_NV_cooperative_matrix
                    sum[zn][zm] = coopMatMulAddNV(A[zm], B[zn], sum[zn][zm]);
#endif
                }
            }
        }

        k += UNROLL_SG_K;
    }

    for (; k < kk; k++)
    {
        barrier();

        // the k steps after the last full UNROLL_SG_K group are packed one by one
        const uint A_offset = ((wgmi * kk + k) * UNROLL_WG_M + sgmi) * Kd4_M_USGM;
        [[unroll]] for (uint q = 0; q < Kd4_M_USGM_d_subgroupsize; q++)
        {
            const uint siq = (q * UNROLL_WG_N + sgni) * subgroup_size + si;

            if (Kd4_M_USGM % (subgroup_size * UNROLL_WG_N) == 0 || siq < Kd4_M_USGM)
            {
                tmp_a[sgmi][siq] = A_blob_data[A_offset + siq];
            }
        }

        const uint B_offset = ((wgni * kk + k) * UNROLL_WG_N + sgni) * Nd4_K_USGN;
        [[unroll]] for (uint q = 0; q < Nd4_K_USGN_d_subgroupsize; q++)
        {
            const uint siq = (q * UNROLL_WG_M + sgmi) * subgroup_size + si;

            if (Nd4_K_USGN % (subgroup_size * UNROLL_WG_M) == 0 || siq < Nd4_K_USGN)
            {
                tmp_b[sgni][siq] = B_blob_data[B_offset + siq];
            }
        }

        barrier();

#if ncnn_VK_KHR_cooperative_matrix
        coopmat<float16_t, gl_ScopeSubgroup, M, K, gl_MatrixUseA> A[UNROLL_SG_M];
        coopmat<float16_t, gl_ScopeSubgroup, K, N, gl_MatrixUseB> B[UNROLL_SG_N];
#elif ncnn_VK_NV_cooperative_matrix
        fcoopmatNV<16, gl_ScopeSubgroup, M, K> A[UNROLL_SG_M];
        fcoopmatNV<16, gl_ScopeSubgroup, K, N> B[UNROLL_SG_N];
#endif

        [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
        {
#if ncnn_VK_KHR_cooperative_matrix
            coopMatLoad(A[zm], tmp_a[sgmi], zm * (Kd4 * M), coopmat_fp16_stride(Kd4), gl_CooperativeMatrixLayoutRowMajor);
#elif ncnn_VK_NV_cooperative_matrix
            coopMatLoadNV(A[zm], tmp_a[sgmi], zm * (Kd4 * M), Kd4, false);
#endif
        }

        [[unroll]] for (uint zn = 0; zn < UNROLL_SG_N; zn++)
        {
#if ncnn_VK_KHR_cooperative_matrix
            coopMatLoad(B[zn], tmp_b[sgni], zn * (Nd4 * K), coopmat_fp16_stride(Nd4), gl_CooperativeMatrixLayoutRowMajor);
#elif ncnn_VK_NV_cooperative_matrix
            coopMatLoadNV(B[zn], tmp_b[sgni], zn * (Nd4 * K), Nd4, false);
#endif
        }

        [[unroll]] for (uint zn = 0; zn < UNROLL_SG_N; zn++)
        {
            [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
            {
#if ncnn_VK_KHR_cooperative_matrix
                sum[zn][zm] = coopMatMulAdd(A[zm], B[zn], sum[zn][zm]);
#elif ncnn_VK_NV_cooperative_matrix
                sum[zn][zm] = coopMatMulAddNV(A[zm], B[zn], sum[zn][zm]);
#endif
            }
        }
    }

    // fp32 accumulators go through shared memory to apply the row and column scales
    [[unroll]] for (uint zn = 0; zn < UNROLL_SG_N; zn++)
    {
        [[unroll]] for (uint zm = 0; zm < UNROLL_SG_M; zm++)
        {
#if ncnn_VK_KHR_cooperative_matrix
            coopMatStore(sum[zn][zm], tmp_o[sgi], (zn * UNROLL_SG_M + zm) * (M * N), N, gl_CooperativeMatrixLayoutRowMajor);
#elif ncnn_VK_NV_cooperative_matrix
            coopMatStoreNV(sum[zn][zm], tmp_o[sgi], (zn * UNROLL_SG_M + zm) * (M * N), N, false);
#endif
        }
    }

    barrier();

    // each lane finishes four outputs that are adjacent in top_blob, neighbouring lanes stay adjacent
    const uint MN_d4 = M * N / 4;
    const uint MN_d4_USGM_USGN = MN_d4 * UNROLL_SG_M * UNROLL_SG_N;
    const uint MN_d4_USGM_USGN_d_subgroupsize = (MN_d4_USGM_USGN + subgroup_size - 1) / subgroup_size;

    [[unroll]] for (uint q = 0; q < MN_d4_USGM_USGN_d_subgroupsize; q++)
    {
        const uint siq = si + q * subgroup_size;

        if (MN_d4_USGM_USGN % subgroup_size == 0 || siq < MN_d4_USGM_USGN)
        {
            const uint zn = siq / (MN_d4 * UNROLL_SG_M);
            const uint zmij = siq % (MN_d4 * UNROLL_SG_M);
            const uint zm = zmij / MN_d4;
            const uint ij = zmij % MN_d4;

            uint i;
            uint j;
            uint di;
            uint dj;
            if (output_transpose == 0 && psc(out_elempack) != 4)
            {
                i = ij / Nd4;
                j = ij % Nd4 * 4;
                di = 0;
                dj = 1;
            }
            else if (output_transpose == 0)
            {
                i = ij / N * 4;
                j = ij % N;
                di = 1;
                dj = 0;
            }
            else if (psc(out_elempack) != 4)
            {
                i = ij % Md4 * 4;
                j = ij / Md4;
                di = 1;
                dj = 0;
            }
            else
            {
                i = ij % M;
                j = ij / M * 4;
                di = 0;
                dj = 1;
            }

            vec4 v;
            bvec4 do_store;
            [[unroll]] for (uint e = 0; e < 4; e++)
            {
                const uint ie = i + e * di;
                const uint je = j + e * dj;
                const int gm = int((mi + zm) * M + ie);
                const int gn = int((ni + zn) * N + je);
                const bool valid = gm < psc(GM) && gn < psc(GN);

                const int sa = tmp_sa[(sgmi * UNROLL_SG_M + zm) * M + ie];
                const int sb = tmp_sb[(sgni * UNROLL_SG_N + zn) * N + je];
                const float c = valid ? load_c(gm, gn) : 0.f;
                const float r = restore_scale(tmp_o[sgi][(zn * UNROLL_SG_M + zm) * (M * N) + ie * N + je], sa + sb);

                // outputs that need fp32 are written by the fallback below
                const bool fp32 = valid && needs_fp32(sa, sb, c, r);
                if (fp32)
                {
                    const uint lm = (sgmi * UNROLL_SG_M + zm) * M + ie;
                    const uint ln = (sgni * UNROLL_SG_N + zn) * N + je;
                    const int slot = atomicAdd(tmp_fallback_count, 1);
                    if (slot < int(local_size * 2))
                        tmp_fallback_list[slot] = (lm << 16) | ln;
                }
                do_store[e] = valid && !fp32;

                v[e] = (r + c) * alpha;
            }

            const int gm0 = int((mi + zm) * M + i);
            const int gn0 = int((ni + zn) * N + j);
            const int offset = output_offset(gm0, gn0);
            if (all(do_store) && offset % 4 == 0)
            {
                buffer_st4(top_blob_data_4, offset / 4, v);
            }
            else
            {
                [[unroll]] for (uint e = 0; e < 4; e++)
                {
                    if (do_store[e])
                        buffer_st1(top_blob_data, output_offset(gm0 + int(e * di), gn0 + int(e * dj)), v[e]);
                }
            }
        }
    }

    barrier();

    const int fallback_count = tmp_fallback_count;
    if (fallback_count == 0)
        return;

    const int gm0 = int(wgmi * BM);
    const int gn0 = int(wgni * BN);

    if (fallback_count <= int(local_size * 2))
    {
        // a few rows or columns, spread their outputs evenly over the workgroup
        for (int t = int(li); t < fallback_count; t += int(local_size))
        {
            const uint lmn = tmp_fallback_list[t];
            const int gm = gm0 + int(lmn >> 16);
            const int gn = gn0 + int(lmn & 0xffffu);
            buffer_st1(top_blob_data, output_offset(gm, gn), gemm_fp32(gm, gn) * alpha);
        }
        return;
    }

    // fp32 tile of the whole workgroup in C-first k order, each lane owns 4x4 output blocks
    const uint BMd4_BNd4 = BM / 4 * (BN / 4);
    const uint QPT = (BMd4_BNd4 + local_size - 1) / local_size;

    // acc[qp][x][y] is output row lr + x and column lc + y
    vec4 acc[QPT][4];
    [[unroll]] for (uint qp = 0; qp < QPT; qp++)
    {
        const uint qd = li + qp * local_size;
        const uint lr = qd / (BN / 4) * 4;
        const uint lc = qd % (BN / 4) * 4;

        [[unroll]] for (uint x = 0; x < 4; x++)
        {
            [[unroll]] for (uint y = 0; y < 4; y++)
            {
                const int gm = gm0 + int(lr + x);
                const int gn = gn0 + int(lc + y);
                acc[qp][x][y] = qd < BMd4_BNd4 && gm < psc(GM) && gn < psc(GN) ? load_c(gm, gn) : 0.f;
            }
        }
    }

    // A pairs hold two depths of one row, B pairs hold two columns at one depth
    const uint SA = BM * KC / 2;
    const uint SB = KC * BN / 2;
    const uint SA_d_localsize = (SA + local_size - 1) / local_size;
    const uint SB_d_localsize = (SB + local_size - 1) / local_size;

    vec2 prefetch_a[SA_d_localsize];
    vec2 prefetch_b[SB_d_localsize];

    // the next chunk is fetched into registers while the current one is computed
    {
        const int kn = 0;

        [[unroll]] for (uint x = 0; x < SA_d_localsize; x++)
        {
            const uint t = li + x * local_size;
            const int gm = gm0 + int(t / (KC / 2));
            const int gk = kn + int(t % (KC / 2) * 2);
            // clamped unconditional loads keep the fetches of one chunk in flight together
            const int gmc = min(gm, psc(GM) - 1);
            const float v0 = load_a(gmc, min(gk, psc(GK) - 1));
            const float v1 = load_a(gmc, min(gk + 1, psc(GK) - 1));
            const bool row_valid = (SA % local_size == 0 || t < SA) && gm < psc(GM);
            prefetch_a[x] = vec2(row_valid && gk < psc(GK) ? v0 : 0.f, row_valid && gk + 1 < psc(GK) ? v1 : 0.f);
        }
        [[unroll]] for (uint x = 0; x < SB_d_localsize; x++)
        {
            const uint t = li + x * local_size;
            const int gk = kn + int(t / (BN / 2));
            const int gn = gn0 + int(t % (BN / 2) * 2);
            const int gkc = min(gk, psc(GK) - 1);
            const float v0 = load_b(gkc, min(gn, psc(GN) - 1));
            const float v1 = load_b(gkc, min(gn + 1, psc(GN) - 1));
            const bool depth_valid = (SB % local_size == 0 || t < SB) && gk < psc(GK);
            prefetch_b[x] = vec2(depth_valid && gn < psc(GN) ? v0 : 0.f, depth_valid && gn + 1 < psc(GN) ? v1 : 0.f);
        }
    }

    for (int k = 0; k < psc(GK); k += int(KC))
    {
        barrier();

        [[unroll]] for (uint x = 0; x < SA_d_localsize; x++)
        {
            const uint t = li + x * local_size;
            if (SA % local_size == 0 || t < SA)
                store_fallback_a(t, prefetch_a[x]);
        }
        [[unroll]] for (uint x = 0; x < SB_d_localsize; x++)
        {
            const uint t = li + x * local_size;
            if (SB % local_size == 0 || t < SB)
                store_fallback_b(t, prefetch_b[x]);
        }

        barrier();

        const int kn = k + int(KC);
        if (kn < psc(GK))
        {
            [[unroll]] for (uint x = 0; x < SA_d_localsize; x++)
            {
                const uint t = li + x * local_size;
                const int gm = gm0 + int(t / (KC / 2));
                const int gk = kn + int(t % (KC / 2) * 2);
                // clamped unconditional loads keep the fetches of one chunk in flight together
                const int gmc = min(gm, psc(GM) - 1);
                const float v0 = load_a(gmc, min(gk, psc(GK) - 1));
                const float v1 = load_a(gmc, min(gk + 1, psc(GK) - 1));
                const bool row_valid = (SA % local_size == 0 || t < SA) && gm < psc(GM);
                prefetch_a[x] = vec2(row_valid && gk < psc(GK) ? v0 : 0.f, row_valid && gk + 1 < psc(GK) ? v1 : 0.f);
            }
            [[unroll]] for (uint x = 0; x < SB_d_localsize; x++)
            {
                const uint t = li + x * local_size;
                const int gk = kn + int(t / (BN / 2));
                const int gn = gn0 + int(t % (BN / 2) * 2);
                const int gkc = min(gk, psc(GK) - 1);
                const float v0 = load_b(gkc, min(gn, psc(GN) - 1));
                const float v1 = load_b(gkc, min(gn + 1, psc(GN) - 1));
                const bool depth_valid = (SB % local_size == 0 || t < SB) && gk < psc(GK);
                prefetch_b[x] = vec2(depth_valid && gn < psc(GN) ? v0 : 0.f, depth_valid && gn + 1 < psc(GN) ? v1 : 0.f);
            }
        }

        const int kc_end = min(int(KC), psc(GK) - k);
        for (int kc = 0; kc < kc_end; kc += 2)
        {
            [[unroll]] for (uint qp = 0; qp < QPT; qp++)
            {
                const uint qd = li + qp * local_size;
                const uint lr = qd / (BN / 4) * 4;
                const uint lc = qd % (BN / 4) * 4;

                vec2 a[4];
                [[unroll]] for (uint x = 0; x < 4; x++)
                {
                    a[x] = load_fallback_a(((lr + x) * KC + kc) / 2);
                }

                const vec4 b0 = vec4(load_fallback_b((kc * BN + lc) / 2), load_fallback_b((kc * BN + lc) / 2 + 1));
                [[unroll]] for (uint x = 0; x < 4; x++)
                {
                    acc[qp][x] = fma(vec4(a[x].x), b0, acc[qp][x]);
                }

                // keep the exact fp32 operation sequence for an odd depth tail
                if (kc + 1 < kc_end)
                {
                    const vec4 b1 = vec4(load_fallback_b(((kc + 1) * BN + lc) / 2), load_fallback_b(((kc + 1) * BN + lc) / 2 + 1));
                    [[unroll]] for (uint x = 0; x < 4; x++)
                    {
                        acc[qp][x] = fma(vec4(a[x].y), b1, acc[qp][x]);
                    }
                }
            }
        }
    }

    [[unroll]] for (uint qp = 0; qp < QPT; qp++)
    {
        const uint qd = li + qp * local_size;
        const uint lr = qd / (BN / 4) * 4;
        const uint lc = qd % (BN / 4) * 4;

        [[unroll]] for (uint x = 0; x < 16; x++)
        {
            const uint lm = lr + x / 4;
            const uint ln = lc + x % 4;
            const int gm = gm0 + int(lm);
            const int gn = gn0 + int(ln);
            if (qd >= BMd4_BNd4 || gm >= psc(GM) || gn >= psc(GN))
                continue;

            // the accumulator of the owning subgroup decides like the store pass above
            const uint osgi = lm / (UNROLL_SG_M * M) * UNROLL_WG_N + ln / (UNROLL_SG_N * N);
            const uint ozm = lm / M % UNROLL_SG_M;
            const uint ozn = ln / N % UNROLL_SG_N;
            const int sa = tmp_sa[lm];
            const int sb = tmp_sb[ln];
            const float c = load_c(gm, gn);
            const float r = restore_scale(tmp_o[osgi][(ozn * UNROLL_SG_M + ozm) * (M * N) + (lm % M) * N + ln % N], sa + sb);

            if (needs_fp32(sa, sb, c, r))
                buffer_st1(top_blob_data, output_offset(gm, gn), acc[qp][x / 4][x % 4] * alpha);
        }
    }
}
