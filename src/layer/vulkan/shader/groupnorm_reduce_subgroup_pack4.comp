#version 450

#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(binding = 0) readonly buffer bottom_top_blob { sfpvec4 bottom_top_blob_data[]; };
layout(binding = 1) writeonly buffer mean_blob { float mean_data[]; };
layout(binding = 2) writeonly buffer var_blob { float var_data[]; };

layout(push_constant) uniform parameter
{
    int group_area;
    int channels_g;
    int cstep;
    int group;
} p;

void main()
{
    const int tid = int(gl_LocalInvocationID.x);
    const int group_id = int(gl_WorkGroupID.z);
    const int actual_channel_start = group_id * p.channels_g;
    const int actual_channel_end = actual_channel_start + p.channels_g;
    const int packed_start = actual_channel_start / 4;
    const int packed_end = (actual_channel_end - 1) / 4;
    const float area = float(p.channels_g * p.group_area);

    float sum = 0.f;
    for (int s = tid; s < p.group_area; s += ncnn_subgroupSize)
    {
        for (int pc = packed_start; pc <= packed_end; pc++)
        {
            const vec4 v = vec4(buffer_ld4(bottom_top_blob_data, pc * p.cstep + s));
            const int actual_channel = pc * 4;
            if (actual_channel >= actual_channel_start && actual_channel < actual_channel_end) sum += v.r;
            if (actual_channel + 1 >= actual_channel_start && actual_channel + 1 < actual_channel_end) sum += v.g;
            if (actual_channel + 2 >= actual_channel_start && actual_channel + 2 < actual_channel_end) sum += v.b;
            if (actual_channel + 3 >= actual_channel_start && actual_channel + 3 < actual_channel_end) sum += v.a;
        }
    }

    const float mean = subgroupAdd(sum) / area;
    if (subgroupElect())
    {
        mean_data[group_id] = mean;
    }

    float sqsum = 0.f;
    for (int s = tid; s < p.group_area; s += ncnn_subgroupSize)
    {
        for (int pc = packed_start; pc <= packed_end; pc++)
        {
            const vec4 v = vec4(buffer_ld4(bottom_top_blob_data, pc * p.cstep + s));
            const int actual_channel = pc * 4;
            float d;
            if (actual_channel >= actual_channel_start && actual_channel < actual_channel_end)
            {
                d = v.r - mean;
                sqsum += d * d;
            }
            if (actual_channel + 1 >= actual_channel_start && actual_channel + 1 < actual_channel_end)
            {
                d = v.g - mean;
                sqsum += d * d;
            }
            if (actual_channel + 2 >= actual_channel_start && actual_channel + 2 < actual_channel_end)
            {
                d = v.b - mean;
                sqsum += d * d;
            }
            if (actual_channel + 3 >= actual_channel_start && actual_channel + 3 < actual_channel_end)
            {
                d = v.a - mean;
                sqsum += d * d;
            }
        }
    }

    const float variance = subgroupAdd(sqsum) / area;
    if (subgroupElect())
    {
        var_data[group_id] = variance;
    }
}
