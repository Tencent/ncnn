#version 450

#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(binding = 0) readonly buffer bottom_top_blob { sfpvec4 bottom_top_blob_data[]; };
layout(binding = 1) writeonly buffer mean_blob { vec4 mean_data[]; };
layout(binding = 2) writeonly buffer var_blob { vec4 var_data[]; };

layout(push_constant) uniform parameter
{
    int group_size;
    int num_groups_per_channel;
    int cstep;
} p;

void main()
{
    const int tid = int(gl_LocalInvocationID.x);
    const int group_id = int(gl_WorkGroupID.z) * p.num_groups_per_channel + int(gl_WorkGroupID.y);

    const int gz = group_id / p.num_groups_per_channel;
    const int gy = group_id % p.num_groups_per_channel;
    const int offset = gz * p.cstep + gy * p.group_size;
    const float area = float(p.group_size);

    vec4 sum = vec4(0.f);
    for (int t = tid; t < p.group_size; t += ncnn_subgroupSize)
    {
        sum += vec4(buffer_ld4(bottom_top_blob_data, offset + t));
    }

    const vec4 mean = subgroupAdd(sum) / area;
    if (subgroupElect())
    {
        mean_data[group_id] = mean;
    }

    vec4 sqsum = vec4(0.f);
    for (int t = tid; t < p.group_size; t += ncnn_subgroupSize)
    {
        const vec4 d = vec4(buffer_ld4(bottom_top_blob_data, offset + t)) - mean;
        sqsum += d * d;
    }

    const vec4 variance = subgroupAdd(sqsum) / area;
    if (subgroupElect())
    {
        var_data[group_id] = variance;
    }
}
