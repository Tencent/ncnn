#version 450

layout(constant_id = 0) const int trans = 0;

layout(binding = 0) readonly buffer bottom_blob { sfp bottom_blob_data[]; };
layout(binding = 1) writeonly buffer scales_blob { int scales_data[]; };

layout(push_constant) uniform parameter
{
    int outer_size;
    int K;
    int hstep;
    int elempack;
} p;

shared int tmp_min[64];
shared int tmp_max[64];

void main()
{
    const int i = int(gl_WorkGroupID.x);
    const int li = int(gl_LocalInvocationID.x);

    if (i >= p.outer_size)
        return;

    int emin = 128;
    int emax = -127;
    for (int k = li; k < p.K; k += 64)
    {
        const int row = trans == 0 ? i : k;
        const int col = trans == 0 ? k : i;
        const int offset = (row / p.elempack * p.hstep + col) * p.elempack + row % p.elempack;
        const uint v = floatBitsToUint(float(buffer_ld1(bottom_blob_data, offset))) & 0x7fffffffu;
        if (v == 0)
            continue;

        const int e = int(v >> 23);
        if (e == 0 || e == 255)
        {
            // subnormal and nonfinite inputs use the fp32 path
            emin = -256;
        }
        else
        {
            emin = min(emin, e - 127);
            emax = max(emax, e - 127);
        }
    }

    tmp_min[li] = emin;
    tmp_max[li] = emax;
    barrier();

    for (int stride = 32; stride > 0; stride /= 2)
    {
        if (li < stride)
        {
            tmp_min[li] = min(tmp_min[li], tmp_min[li + stride]);
            tmp_max[li] = max(tmp_max[li], tmp_max[li + stride]);
        }
        barrier();
    }

    if (li == 0)
    {
        const int s = max(tmp_max[0] - 15, -112);
        if (tmp_min[0] == -256 || tmp_min[0] - s < -14)
            scales_data[i] = 256;
        else
            scales_data[i] = tmp_max[0] == -127 ? 0 : s;
    }
}
