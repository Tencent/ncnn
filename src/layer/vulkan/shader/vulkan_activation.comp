#ifndef NCNN_VULKAN_ACTIVATION_COMP
#define NCNN_VULKAN_ACTIVATION_COMP

afp activation_afp(afp v, int activation_type, float activation_param_0, float activation_param_1)
{
    if (activation_type == 1)
    {
        v = max(v, afp(0.f));
    }
    if (activation_type == 2)
    {
        const afp slope = afp(activation_param_0);
        v = v < afp(0.f) ? v * slope : v;
    }
    if (activation_type == 3)
    {
        const afp const_min = afp(activation_param_0);
        const afp const_max = afp(activation_param_1);
        v = clamp(v, const_min, const_max);
    }
    if (activation_type == 4)
    {
        v = afp(1.f) / (afp(1.f) + exp(-v));
    }
    if (activation_type == 5)
    {
#if NCNN_moltenvk
        v = v * afp(tanh(float(log(exp(v) + afp(1.f)))));
#else
        v = v * tanh(log(exp(v) + afp(1.f)));
#endif
    }
    if (activation_type == 6)
    {
        const afp alpha = afp(activation_param_0);
        const afp beta = afp(activation_param_1);
        v = v * clamp(v * afp(alpha) + afp(beta), afp(0.f), afp(1.f));
    }
    if (activation_type == 7)
    {
        // GELU
        // activation_param_0 carries the fast_gelu flag, the host passes the plain numeric value
        if (activation_param_0 != 0.f)
        {
            // y = 0.5x * (1 + tanh(sqrt(2/Pi) * (x + 0.044715x^3)))
            afp x = afp(0.79788452f) * (v + afp(0.044715f) * v * v * v);
            // avoid overflow in tanh implementations based on exp(x) and exp(-x)
            x = min(max(x, afp(-10.f)), afp(10.f));
#if NCNN_moltenvk
            v = afp(0.5f) * v * (afp(1.f) + afp(tanh(float(x))));
#else
            v = afp(0.5f) * v * (afp(1.f) + tanh(x));
#endif
        }
        else
        {
            // y = 0.5 * x * erfc(-x / sqrt(2))
            // glsl has no erfc builtin, erf is evaluated with the Abramowitz and Stegun
            // 7.1.26 rational approximation (absolute error below 1.5e-7)
            const afp z = afp(0.70710678f) * v;
            const afp az = max(z, -z);
            const afp t = afp(1.f) / (afp(1.f) + afp(0.3275911f) * az);
            afp p = t * (afp(0.254829592f) + t * (afp(-0.284496736f) + t * (afp(1.421413741f) + t * (afp(-1.453152027f) + t * afp(1.061405429f)))));
            p = afp(1.f) - p * exp(-az * az);
            const afp erfz = z < afp(0.f) ? -p : p;
            v = afp(0.5f) * v * (afp(1.f) + erfz);
        }
    }
    if (activation_type == 8)
    {
        // SiLU/Swish: y = x / (1 + exp(-x))
        v = v / (afp(1.f) + exp(-v));
    }
    if (activation_type == 9)
    {
        // ELU: y = x if x >= 0 else alpha * (exp(x) - 1)
        const afp alpha = afp(activation_param_0);
        v = v >= afp(0.f) ? v : alpha * (exp(v) - afp(1.f));
    }
    if (activation_type == 10)
    {
        // SELU: y = lambda * x if x >= 0 else lambda * alpha * (exp(x) - 1)
        const afp alpha = afp(activation_param_0);
        const afp lambda = afp(activation_param_1);
        v = v >= afp(0.f) ? lambda * v : lambda * alpha * (exp(v) - afp(1.f));
    }

    return v;
}

afpvec4 activation_afpvec4(afpvec4 v, int activation_type, float activation_param_0, float activation_param_1)
{
    if (activation_type == 1)
    {
        v = max(v, afp(0.f));
    }
    if (activation_type == 2)
    {
        const afp slope = afp(activation_param_0);
        v = mix(v, v * afp(slope), lessThan(v, afpvec4(0.f)));
    }
    if (activation_type == 3)
    {
        const afp const_min = afp(activation_param_0);
        const afp const_max = afp(activation_param_1);
        v = clamp(v, const_min, const_max);
    }
    if (activation_type == 4)
    {
        v = afp(1.f) / (afp(1.f) + exp(-v));
    }
    if (activation_type == 5)
    {
#if NCNN_moltenvk
        v = v * afpvec4(tanh(vec4(log(exp(v) + afp(1.f)))));
#else
        v = v * tanh(log(exp(v) + afp(1.f)));
#endif
    }
    if (activation_type == 6)
    {
        const afp alpha = afp(activation_param_0);
        const afp beta = afp(activation_param_1);
        v = v * clamp(v * afp(alpha) + afp(beta), afp(0.f), afp(1.f));
    }
    if (activation_type == 7)
    {
        // GELU
        // activation_param_0 carries the fast_gelu flag, the host passes the plain numeric value
        if (activation_param_0 != 0.f)
        {
            // y = 0.5x * (1 + tanh(sqrt(2/Pi) * (x + 0.044715x^3)))
            afpvec4 x = afpvec4(0.79788452f) * (v + afpvec4(0.044715f) * v * v * v);
            // avoid overflow in tanh implementations based on exp(x) and exp(-x)
            x = clamp(x, afpvec4(-10.f), afpvec4(10.f));
#if NCNN_moltenvk
            v = afpvec4(0.5f) * v * (afpvec4(1.f) + afpvec4(tanh(vec4(x))));
#else
            v = afpvec4(0.5f) * v * (afpvec4(1.f) + tanh(x));
#endif
        }
        else
        {
            // y = 0.5 * x * erfc(-x / sqrt(2))
            // glsl has no erfc builtin, erf is evaluated with the Abramowitz and Stegun
            // 7.1.26 rational approximation (absolute error below 1.5e-7)
            const afpvec4 z = afpvec4(0.70710678f) * v;
            const afpvec4 az = max(z, -z);
            const afpvec4 t = afpvec4(1.f) / (afpvec4(1.f) + afpvec4(0.3275911f) * az);
            afpvec4 p = t * (afpvec4(0.254829592f) + t * (afpvec4(-0.284496736f) + t * (afpvec4(1.421413741f) + t * (afpvec4(-1.453152027f) + t * afpvec4(1.061405429f)))));
            p = afpvec4(1.f) - p * exp(-az * az);
            v = afpvec4(0.5f) * v * (afpvec4(1.f) + mix(p, -p, lessThan(z, afpvec4(0.f))));
        }
    }
    if (activation_type == 8)
    {
        // SiLU/Swish: y = x / (1 + exp(-x))
        v = v / (afp(1.f) + exp(-v));
    }
    if (activation_type == 9)
    {
        // ELU: y = x if x >= 0 else alpha * (exp(x) - 1)
        const afp alpha = afp(activation_param_0);
        v = mix(v, afpvec4(alpha) * (exp(v) - afpvec4(1.f)), lessThan(v, afpvec4(0.f)));
    }
    if (activation_type == 10)
    {
        // SELU: y = lambda * x if x >= 0 else lambda * alpha * (exp(x) - 1)
        const afp alpha = afp(activation_param_0);
        const afp lambda = afp(activation_param_1);
        v = mix(afpvec4(lambda) * v, afpvec4(lambda * alpha) * (exp(v) - afpvec4(1.f)), lessThan(v, afpvec4(0.f)));
    }

    return v;
}

#endif // NCNN_VULKAN_ACTIVATION_COMP
