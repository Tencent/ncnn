#version 450

#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(binding = 0) readonly buffer bottom_top_blob { sfpvec4 bottom_top_blob_data[]; };
layout(binding = 1) writeonly buffer mean_blob { float mean_data[]; };
layout(binding = 2) writeonly buffer var_blob { float var_data[]; };

layout(push_constant) uniform parameter
{
    int cstep;
    int size;
} p;

void main()
{
    const int tid = int(gl_LocalInvocationID.x);
    const int packed_channel_id = int(gl_WorkGroupID.z);
    const int actual_channel_base = packed_channel_id * 4;
    const int base_offset = packed_channel_id * p.cstep;
    const float area = float(p.size);

    vec4 sum = vec4(0.f);
    for (int t = tid; t < p.size; t += ncnn_subgroupSize)
    {
        sum += vec4(buffer_ld4(bottom_top_blob_data, base_offset + t));
    }

    const vec4 mean = subgroupAdd(sum) / area;
    if (subgroupElect())
    {
        mean_data[actual_channel_base + 0] = mean.r;
        mean_data[actual_channel_base + 1] = mean.g;
        mean_data[actual_channel_base + 2] = mean.b;
        mean_data[actual_channel_base + 3] = mean.a;
    }

    vec4 sqsum = vec4(0.f);
    for (int t = tid; t < p.size; t += ncnn_subgroupSize)
    {
        const vec4 d = vec4(buffer_ld4(bottom_top_blob_data, base_offset + t)) - mean;
        sqsum += d * d;
    }

    const vec4 variance = subgroupAdd(sqsum) / area;
    if (subgroupElect())
    {
        var_data[actual_channel_base + 0] = variance.r;
        var_data[actual_channel_base + 1] = variance.g;
        var_data[actual_channel_base + 2] = variance.b;
        var_data[actual_channel_base + 3] = variance.a;
    }
}
