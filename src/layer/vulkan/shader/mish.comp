#version 450

layout(constant_id = 0) const uint n = 0;

layout(binding = 0) buffer bottom_top_blob { sfpvec4 bottom_top_blob_data[]; };

layout(push_constant) uniform parameter
{
    uint n;
} p;

void main()
{
    uint gi = gl_GlobalInvocationID.x;

    if (gi >= psc(n))
        return;

    afpvec4 v = buffer_ld4(bottom_top_blob_data, gi);

    // softplus(x) = log(exp(x) + 1)
    // exp(x) overflows to inf above about 88 in fp32 and 11 in fp16, and some tanh
    // implementations return nan for inf. tanh(softplus(10)) is 1 to within 1e-8,
    // so clamp before exp, as gelu.comp clamps its tanh input.
    afpvec4 sp = log(exp(min(v, afpvec4(10.f))) + afpvec4(1.f));

#if NCNN_moltenvk
    v = v * afpvec4(tanh(vec4(sp)));
#else
    v = v * tanh(sp);
#endif

    buffer_st4(bottom_top_blob_data, gi, v);
}
