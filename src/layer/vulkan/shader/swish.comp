#version 450

layout(constant_id = 0) const uint n = 0;

layout(binding = 0) buffer bottom_top_blob { sfpvec4 bottom_top_blob_data[]; };

layout(push_constant) uniform parameter
{
    uint n;
} p;

void main()
{
    uint gi = gl_GlobalInvocationID.x;

    if (gi >= psc(n))
        return;

    afpvec4 v = buffer_ld4(bottom_top_blob_data, gi);

    // keep the internal state wide: exp(-v) overflows the fp16 range for
    // v < ~-11, so a fp16 silu silently clamps the tail of the sigmoid to zero
    // and biases the gating.  only the storage stays 16-bit.
    wfpvec4 vf = wfpvec4(v);
    vf = vf / (wfpvec4(1.f) + exp(-vf));

    buffer_st4(bottom_top_blob_data, gi, afpvec4(vf));
}
