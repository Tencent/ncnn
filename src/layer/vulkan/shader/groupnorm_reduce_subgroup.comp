#version 450

#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(binding = 0) readonly buffer bottom_top_blob { sfp bottom_top_blob_data[]; };
layout(binding = 1) writeonly buffer mean_blob { float mean_data[]; };
layout(binding = 2) writeonly buffer var_blob { float var_data[]; };

layout(push_constant) uniform parameter
{
    int group_area;
    int channels_g;
    int cstep;
    int group;
} p;

void main()
{
    const int tid = int(gl_LocalInvocationID.x);
    const int group_id = int(gl_WorkGroupID.z);
    const int actual_channel_start = group_id * p.channels_g;
    const int group_size = p.channels_g * p.group_area;
    const float area = float(group_size);

    float sum = 0.f;
    for (int t = tid; t < group_size; t += ncnn_subgroupSize)
    {
        const int q = t / p.group_area;
        const int s = t % p.group_area;
        const int actual_channel = actual_channel_start + q;
        const float v = float(buffer_ld1(bottom_top_blob_data, actual_channel * p.cstep + s));
        sum += v;
    }

    const float mean = subgroupAdd(sum) / area;
    if (subgroupElect())
    {
        mean_data[group_id] = mean;
    }

    float sqsum = 0.f;
    for (int t = tid; t < group_size; t += ncnn_subgroupSize)
    {
        const int q = t / p.group_area;
        const int s = t % p.group_area;
        const int actual_channel = actual_channel_start + q;
        const float d = float(buffer_ld1(bottom_top_blob_data, actual_channel * p.cstep + s)) - mean;
        sqsum += d * d;
    }

    const float variance = subgroupAdd(sqsum) / area;
    if (subgroupElect())
    {
        var_data[group_id] = variance;
    }
}
