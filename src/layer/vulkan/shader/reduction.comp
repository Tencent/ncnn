#version 450

#if ncnn_subgroup_basic && ncnn_subgroup_arithmetic && (!NCNN_fp16_arithmetic || ncnn_shaderSubgroupExtendedTypes)
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#if NCNN_fp16_arithmetic && !NCNN_bf16_storage && !NCNN_bf16_packed
#extension GL_EXT_shader_subgroup_extended_types_float16 : require
#endif
#endif

layout(constant_id = 0) const int op = 0;

layout(binding = 0) writeonly buffer top_blob { sfp top_blob_data[]; };
layout(binding = 1) readonly buffer bottom_blob { sfp bottom_blob_data[]; };

layout(push_constant) uniform parameter
{
    int in_w;
    int in_h;
    int in_d;
    int in_c;
    int in_cstep;
    int in_dims;

    int out_w;
    int out_h;
    int out_d;
    int out_c;
    int out_dims;
    int out_cstep;

    int reduce_w;
    int reduce_h;
    int reduce_d;
    int reduce_c;

    int map_out_w;
    int map_out_h;
    int map_out_d;
    int map_out_c;

    float coeff;
} p;

shared float sdata[256];
shared float sdata_logsumexp[256];

const float FLT_MAX_VALUE = 3.402823466e+38;
const float FLT_MIN_VALUE = 1.175494351e-38;

float init_acc()
{
    if (op == 6) return 1.f;
    if (op == 4) return -FLT_MAX_VALUE;
    if (op == 5) return FLT_MAX_VALUE;
    return 0.f;
}

float element_accum(float acc, float v)
{
    if (op == 0 || op == 3 || op == 9) return acc + v;
    if (op == 1 || op == 7) return acc + abs(v);
    if (op == 2 || op == 8) return acc + v * v;
    if (op == 4) return max(acc, v);
    if (op == 5) return min(acc, v);
    if (op == 6) return acc * v;
    return acc + v;
}

float combine_accum(float a, float b)
{
    if (op == 4) return max(a, b);
    if (op == 5) return min(a, b);
    if (op == 6) return a * b;
    return a + b;
}

#if ncnn_subgroup_basic && ncnn_subgroup_arithmetic && (!NCNN_fp16_arithmetic || ncnn_shaderSubgroupExtendedTypes)
float subgroup_reduce_acc(float v)
{
    if (op == 4) return subgroupMax(v);
    if (op == 5) return subgroupMin(v);
    if (op == 6) return subgroupMul(v);
    return subgroupAdd(v);
}
#endif

void decode_out(int out_index, out int ow, out int oh, out int od, out int oc)
{
    ow = 0;
    oh = 0;
    od = 0;
    oc = 0;

    if (p.out_dims == 1)
    {
        ow = out_index;
    }
    else if (p.out_dims == 2)
    {
        ow = out_index % p.out_w;
        oh = out_index / p.out_w;
    }
    else if (p.out_dims == 3)
    {
        ow = out_index % p.out_w;
        int t = out_index / p.out_w;
        oh = t % p.out_h;
        oc = t / p.out_h;
    }
    else
    {
        ow = out_index % p.out_w;
        int t0 = out_index / p.out_w;
        oh = t0 % p.out_h;
        int t1 = t0 / p.out_h;
        od = t1 % p.out_d;
        oc = t1 / p.out_d;
    }
}

int in_index(int iw, int ih, int id, int ic)
{
    if (p.in_dims == 1) return iw;
    if (p.in_dims == 2) return ih * p.in_w + iw;
    if (p.in_dims == 3) return ic * p.in_cstep + ih * p.in_w + iw;

    int in_dstep = p.in_w * p.in_h;
    return ic * p.in_cstep + id * in_dstep + ih * p.in_w + iw;
}

int out_offset(int ow, int oh, int od, int oc)
{
    if (p.out_dims == 1) return ow;
    if (p.out_dims == 2) return oh * p.out_w + ow;
    if (p.out_dims == 3) return oc * p.out_cstep + oh * p.out_w + ow;

    int out_dstep = p.out_w * p.out_h;
    return oc * p.out_cstep + od * out_dstep + oh * p.out_w + ow;
}

int reduce_in_index(int t, int in_coord[4], int in_w, int in_h, int in_d, int in_c)
{
    int iw = in_coord[3];
    int ih = in_coord[2];
    int id = in_coord[1];
    int ic = in_coord[0];

    if (p.reduce_w != 0)
    {
        iw = t % in_w;
        t /= in_w;
    }
    if (p.reduce_h != 0)
    {
        ih = t % in_h;
        t /= in_h;
    }
    if (p.in_dims == 4 && p.reduce_d != 0)
    {
        id = t % in_d;
        t /= in_d;
    }
    if (p.in_dims >= 3 && p.reduce_c != 0) { ic = t % in_c; }

    return in_index(iw, ih, id, ic);
}

float finalize_out(float outv)
{
    if (op == 9) outv = log(outv);
    if (op == 8) outv = sqrt(outv < FLT_MIN_VALUE ? 0.f : outv);
    if (p.coeff != 1.f) outv = outv * p.coeff;
    return outv;
}

void main()
{
    const int out_index = int(gl_WorkGroupID.y);
    const int tid = int(gl_LocalInvocationID.x);

    int ow, oh, od, oc;
    decode_out(out_index, ow, oh, od, oc);

    int in_coord[4] = int[4](0, 0, 0, 0);
    if (p.map_out_w >= 0) in_coord[p.map_out_w] = ow;
    if (p.map_out_h >= 0) in_coord[p.map_out_h] = oh;
    if (p.map_out_d >= 0) in_coord[p.map_out_d] = od;
    if (p.map_out_c >= 0) in_coord[p.map_out_c] = oc;

    int in_w = p.in_w;
    int in_h = (p.in_h > 0) ? p.in_h : 1;
    int in_d = (p.in_d > 0) ? p.in_d : 1;
    int in_c = (p.in_c > 0) ? p.in_c : 1;

    int reduce_size = 1;
    if (p.reduce_w != 0) reduce_size *= in_w;
    if (p.reduce_h != 0) reduce_size *= in_h;
    if (p.in_dims == 4 && p.reduce_d != 0) reduce_size *= in_d;
    if (p.in_dims >= 3 && p.reduce_c != 0) reduce_size *= in_c;

    if (op == 10)
    {
        // subtracting the max keeps every exp argument non-positive
        float max_value = -FLT_MAX_VALUE;

        for (int t = tid; t < reduce_size; t += 256)
        {
            float v = float(buffer_ld1(bottom_blob_data, reduce_in_index(t, in_coord, in_w, in_h, in_d, in_c)));
            max_value = max(max_value, v);
        }

#if ncnn_subgroup_basic && ncnn_subgroup_arithmetic && (!NCNN_fp16_arithmetic || ncnn_shaderSubgroupExtendedTypes)
        const int num_sg = int(gl_NumSubgroups);

        max_value = subgroupMax(max_value);

        if (subgroupElect())
        {
            sdata_logsumexp[int(gl_SubgroupID)] = max_value;
        }
#else
        const int num_sg = 256;

        sdata_logsumexp[tid] = max_value;
#endif

        barrier();

        for (int stride = num_sg / 2; stride > 0; stride >>= 1)
        {
            if (tid < stride)
            {
                sdata_logsumexp[tid] = max(sdata_logsumexp[tid], sdata_logsumexp[tid + stride]);
            }
            barrier();
        }

        const float max_shift = sdata_logsumexp[0];

        float sum = 0.f;

        for (int t = tid; t < reduce_size; t += 256)
        {
            float v = float(buffer_ld1(bottom_blob_data, reduce_in_index(t, in_coord, in_w, in_h, in_d, in_c)));
            sum += exp(v - max_shift);
        }

        // every invocation reads max_shift before sdata_logsumexp is reused
        barrier();

#if ncnn_subgroup_basic && ncnn_subgroup_arithmetic && (!NCNN_fp16_arithmetic || ncnn_shaderSubgroupExtendedTypes)
        sum = subgroupAdd(sum);

        if (subgroupElect())
        {
            sdata_logsumexp[int(gl_SubgroupID)] = sum;
        }
#else
        sdata_logsumexp[tid] = sum;
#endif

        barrier();

        for (int stride = num_sg / 2; stride > 0; stride >>= 1)
        {
            if (tid < stride)
            {
                sdata_logsumexp[tid] += sdata_logsumexp[tid + stride];
            }
            barrier();
        }

        if (tid == 0)
        {
            afp outv = afp((max_shift + log(sdata_logsumexp[0])) * p.coeff);
            buffer_st1(top_blob_data, out_offset(ow, oh, od, oc), outv);
        }

        return;
    }

    float acc = init_acc();

    for (int t = tid; t < reduce_size; t += 256)
    {
        float v = float(buffer_ld1(bottom_blob_data, reduce_in_index(t, in_coord, in_w, in_h, in_d, in_c)));
        acc = element_accum(acc, v);
    }

#if ncnn_subgroup_basic && ncnn_subgroup_arithmetic && (!NCNN_fp16_arithmetic || ncnn_shaderSubgroupExtendedTypes)
    float sg = subgroup_reduce_acc(acc);

    if (subgroupElect())
    {
        sdata[int(gl_SubgroupID)] = sg;
    }

    barrier();

#if ncnn_subgroupSize >= 16
    // subgroupsize >= 16: num_sg = 256/subgroupsize <= 16 <= subgroupsize
    // One subgroup can cover all partial sums in a single subgroup reduce.
    if (int(gl_SubgroupID) == 0)
    {
        const int lane = int(gl_SubgroupInvocationID);
        const int num_sg = int(gl_NumSubgroups);

        float v = lane < num_sg ? sdata[lane] : init_acc();
        float outv = subgroup_reduce_acc(v);

        if (subgroupElect())
        {
            outv = finalize_out(outv);
            buffer_st1(top_blob_data, out_offset(ow, oh, od, oc), afp(outv));
        }
    }
#elif ncnn_subgroupSize == 8
    // num_sg = 32, subgroupsize = 8
    // Stage 2a: each of the first 4 subgroups reduces 8 consecutive partial sums
    if (int(gl_SubgroupID) < 4)
    {
        const int lane = int(gl_SubgroupInvocationID);
        const int base = int(gl_SubgroupID) * 8;

        float v = sdata[base + lane];
        float r = subgroup_reduce_acc(v);

        if (subgroupElect())
        {
            sdata[base] = r;
        }
    }

    barrier();

    // Stage 2b: subgroup 0 reduces the 4 remaining values
    if (int(gl_SubgroupID) == 0)
    {
        const int lane = int(gl_SubgroupInvocationID);

        float v = lane < 4 ? sdata[lane * 8] : init_acc();
        float outv = subgroup_reduce_acc(v);

        if (subgroupElect())
        {
            outv = finalize_out(outv);
            buffer_st1(top_blob_data, out_offset(ow, oh, od, oc), afp(outv));
        }
    }
#elif ncnn_subgroupSize == 4
    // num_sg = 64, subgroupsize = 4
    // Stage 2a: each of the first 16 subgroups reduces 4 consecutive partial sums
    if (int(gl_SubgroupID) < 16)
    {
        const int lane = int(gl_SubgroupInvocationID);
        const int base = int(gl_SubgroupID) * 4;

        float v = sdata[base + lane];
        float r = subgroup_reduce_acc(v);

        if (subgroupElect())
        {
            sdata[base] = r;
        }
    }

    barrier();

    // Stage 2b: first 4 subgroups each reduce 4 of the 16 remaining values
    if (int(gl_SubgroupID) < 4)
    {
        const int lane = int(gl_SubgroupInvocationID);
        const int base = int(gl_SubgroupID) * 16;

        float v = sdata[base + lane * 4];
        float r = subgroup_reduce_acc(v);

        if (subgroupElect())
        {
            sdata[base] = r;
        }
    }

    barrier();

    // Stage 2c: subgroup 0 reduces the final 4 values
    if (int(gl_SubgroupID) == 0)
    {
        const int lane = int(gl_SubgroupInvocationID);

        float v = sdata[lane * 16];
        float outv = subgroup_reduce_acc(v);

        if (subgroupElect())
        {
            outv = finalize_out(outv);
            buffer_st1(top_blob_data, out_offset(ow, oh, od, oc), afp(outv));
        }
    }
#else
    // General case: num_sg may exceed subgroup size.
    // Use shared memory tree reduction across all threads.
    // sdata[0 .. num_sg-1] holds the partial sums from stage 1.
    // We let threads tid < num_sg participate in the tree reduction.
    {
        const int num_sg = 256 / ncnn_subgroupSize;

        for (int stride = num_sg / 2; stride > 0; stride >>= 1)
        {
            if (tid < stride)
            {
                float a = sdata[tid];
                float b = sdata[tid + stride];
                sdata[tid] = combine_accum(a, b);
            }
            barrier();
        }

        if (tid == 0)
        {
            float outv = sdata[0];
            outv = finalize_out(outv);
            buffer_st1(top_blob_data, out_offset(ow, oh, od, oc), afp(outv));
        }
    }
#endif

#else
    sdata[tid] = acc;
    barrier();

    for (int stride = 128; stride > 0; stride >>= 1)
    {
        if (tid < stride)
        {
            float a = sdata[tid];
            float b = sdata[tid + stride];
            sdata[tid] = combine_accum(a, b);
        }
        barrier();
    }

    if (tid == 0)
    {
        float outv = sdata[0];
        outv = finalize_out(outv);
        buffer_st1(top_blob_data, out_offset(ow, oh, od, oc), afp(outv));
    }
#endif
}
